---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownMenu from "./DropdownMenu.astro";

const navbarTitle = siteConfig.navbar.title || siteConfig.title;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

// 共享下拉面板的内容页：带子菜单的导航项各占一页，
// 页序号与触发器容器上的 data-dropdown-index 配对
interface NavbarDropdownPage {
	index: number;
	children: NavBarLink[];
}

const dropdownPages: NavbarDropdownPage[] = links
	.map((link, index) => ({
		index,
		children: (link.children ?? [])
			.map((child) => (typeof child === "number" ? LinkPresets[child] : child))
			.filter((child): child is NavBarLink => child !== null),
	}))
	.filter((page) => page.children.length > 0);

// Logo
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) logoImg = await file();
}
---

<div id="navbar" class="z-50" data-full-width={String(navbarWidthFull)} style="margin-top: 10px;">
	<div class="navbar-segments">
		<!-- 左段：logo + 标题（滚动收缩成球） -->
		<div class="navbar-seg navbar-seg--left">
			<a href={url("/")} class="navbar-logo scale-animation flex items-center text-(--deep-text)">
				{siteConfig.navbar.logo?.type === "icon" ? (
					<Icon name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} is:inline class="text-[1.35rem] flex-shrink-0" />
				) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
					logoImg.format === "svg" ? (
						<img src={logoImg.src} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
					) : (
						<Picture
							src={logoImg}
							alt={siteConfig.navbar.logo.alt || siteConfig.title}
							class="h-6 w-6 object-contain flex-shrink-0"
							formats={getImageFormats()}
							fallbackFormat={getFallbackFormat()}
							widths={[24, 48]}
							loading="eager"
							fetchpriority="high"
						/>
					)
				) : siteConfig.navbar.logo?.type === "image" ? (
					<img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
				) : siteConfig.navbar.logo?.type === "url" ? (
					<img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
				) : (
					<Icon name="material-symbols:home-pin-outline" is:inline class="text-[1.35rem] flex-shrink-0" />
				)}
				<span class="navbar-logo-text font-mono uppercase tracking-[0.12em] text-xs font-semibold ml-2">{navbarTitle}</span>
			</a>
		</div>

		<!-- 中段：紧凑导航椭圆（滚动不变） -->
		<div class="navbar-seg navbar-seg--center" data-navbar-nav>
			<div class="navbar-nav hidden lg:flex items-center gap-0.5 relative">
				<div class="navbar-hover-highlight" data-hover-border></div>
				{links.map((l, i) => <DropdownMenu link={l} index={i} />)}

				<!-- 共享下拉面板：悬停跟随导航项左右滑动，内容页交叉淡换 -->
				{dropdownPages.length > 0 && (
					<div class="navbar-dropdown-panel" data-navbar-dropdown-panel>
						<span class="navbar-dropdown-arrow" aria-hidden="true"></span>
						<div class="navbar-dropdown-box">
							{dropdownPages.map((page) => (
								<div class="navbar-dropdown-page" data-dropdown-page={page.index}>
									{page.children.map((child, childIndex) => {
										const isLast = childIndex === page.children.length - 1;
										return (
											<DropdownItem
												href={child.external ? child.url : url(child.url)}
												target={child.external ? "_blank" : undefined}
												isLast={isLast}
												class="dropdown-item"
											>
												{child.icon && <Icon name={child.icon} is:inline class="text-[1.2rem] mr-3 navbar-icon" />}
												<span>{child.name}</span>
												{child.external && (
													<Icon name="fa7-solid:arrow-up-right-from-square" is:inline class="text-[0.7rem] text-black/25 dark:text-white/25 ml-auto" />
												)}
											</DropdownItem>
										);
									})}
								</div>
							))}
						</div>
					</div>
				)}
			</div>
		</div>

		<!-- 右段：搜索 + 快捷键（滚动收缩成球），移动端追加菜单按钮 -->
		<div class="navbar-seg navbar-seg--right">
			<button aria-label="Search" name="Search" class="btn-plain h-9 nav-search-btn" id="nav-search-btn">
				<span class="nav-search-btn__shortcut" data-shortcut>⌘ K</span>
				<Icon name="material-symbols:search-rounded" is:inline class="text-[1.4rem]" style="font-variation-settings: 'wght' 700" />
			</button>
			<button aria-label="Menu" name="Nav Menu" class="btn-plain h-9 w-9 lg:hidden!" id="nav-menu-switch">
				<Icon name="material-symbols:menu-rounded" is:inline class="text-[1.2rem]" />
			</button>
		</div>
	</div>
</div>

<script>
import {
	initNavbarDropdownDelegation,
	repositionNavbarDropdown,
	syncNavbarDropdownOnHover,
} from "@/utils/navbar-dropdown-controller";

(function() {
	var _hoverSliderAbortController: AbortController | null = null;
	var _hoverSliderMouseEnterHandlers: Array<[Element, (e: Event) => void]> = [];

	function cleanupHoverSlider() {
		if (_hoverSliderAbortController) {
			_hoverSliderAbortController.abort();
			_hoverSliderAbortController = null;
		}
		_hoverSliderMouseEnterHandlers.forEach(function(entry) {
			entry[0].removeEventListener('mouseenter', entry[1]);
		});
		_hoverSliderMouseEnterHandlers = [];
	}

	function normalizePath(p: string): string {
		return p.replace(/\/$/, '') || '/';
	}

	function pathMatches(currentPath: string, href: string): boolean {
		var cp = normalizePath(currentPath);
		var hp = normalizePath(href);
		if (hp === '/') return cp === '/';
		return cp === hp || cp.startsWith(hp + '/');
	}

	function moveHighlight(navContainer: HTMLElement, hoverBorder: HTMLElement, item: HTMLElement | null) {
		navContainer.querySelectorAll<HTMLElement>(':scope > .dropdown-container').forEach(function(navItem) {
			navItem.classList.toggle('is-highlighted', navItem === item);
		});

		if (!item) {
			hoverBorder.style.opacity = '0';
			return;
		}
		var rect = item.getBoundingClientRect();
		var containerRect = navContainer.getBoundingClientRect();
		hoverBorder.style.width = rect.width + 'px';
		hoverBorder.style.height = rect.height + 'px';
		hoverBorder.style.left = (rect.left - containerRect.left) + 'px';
		hoverBorder.style.top = (rect.top - containerRect.top) + 'px';
		hoverBorder.style.opacity = '1';
	}

	function initHoverSlider() {
		cleanupHoverSlider();

		const navContainer = document.querySelector<HTMLElement>('[data-navbar-nav] .navbar-nav');
		const hoverBorder = document.querySelector<HTMLElement>('[data-hover-border]');
		if (!navContainer || !hoverBorder) return;

		const containerEl = navContainer;
		const borderEl = hoverBorder;

		_hoverSliderAbortController = new AbortController();
		var navItems = Array.from(containerEl.querySelectorAll<HTMLElement>(':scope > .dropdown-container'));

		function detectActiveItem() {
			var currentPath = window.location.pathname;
			var activeItem: HTMLElement | null = null;

			navItems.forEach(function(item) {
				item.classList.remove('nav-item-active');
				var hrefs: string[] = [];
				var selfLink = item.querySelector<HTMLAnchorElement>(':scope > a');
				if (selfLink) {
					var href = selfLink.getAttribute('href');
					if (href) hrefs.push(href);
				}

				// 同时匹配共享面板中该导航项下的全部子菜单链接
				var pageIndex = item.dataset.dropdownIndex;
				var page = pageIndex !== undefined
					? document.querySelector<HTMLElement>('[data-navbar-dropdown-panel] [data-dropdown-page="' + pageIndex + '"]')
					: null;
				if (page) {
					page.querySelectorAll<HTMLAnchorElement>('.dropdown-item[href]').forEach(function(el) {
						var href = el.getAttribute('href');
						if (href) hrefs.push(href);
					});
				}

				var matched = hrefs.some(function(href) { return pathMatches(currentPath, href); });
				if (matched) {
					item.classList.add('nav-item-active');
					if (!activeItem) activeItem = item;
				}
			});

			if (activeItem) {
				containerEl.classList.add('nav-has-active');
				requestAnimationFrame(function() {
					moveHighlight(containerEl, borderEl, activeItem);
				});
			} else {
				containerEl.classList.remove('nav-has-active');
				borderEl.style.opacity = '0';
			}
		}

		navItems.forEach(function(item) {
			var handler = function() {
				moveHighlight(containerEl, borderEl, item);
				syncNavbarDropdownOnHover(item);
			};
			item.addEventListener('mouseenter', handler);
			_hoverSliderMouseEnterHandlers.push([item, handler]);
		});

		containerEl.addEventListener('mouseleave', function() {
			var activeItem = containerEl.querySelector<HTMLElement>('.nav-item-active');
			moveHighlight(containerEl, borderEl, activeItem);
			syncNavbarDropdownOnHover(null);
		}, { signal: _hoverSliderAbortController.signal });

		containerEl.addEventListener('mouseenter', function() {
			borderEl.style.opacity = '1';
		}, { signal: _hoverSliderAbortController.signal });

		initNavbarDropdownDelegation();
		window.addEventListener('resize', repositionNavbarDropdown, {
			passive: true,
			signal: _hoverSliderAbortController.signal,
		});

		detectActiveItem();
		document.addEventListener('astro:page-load', detectActiveItem, { signal: _hoverSliderAbortController.signal });
	}

	initHoverSlider();

	// Scroll shrink effect
	(function() {
		var navbar = document.getElementById('navbar');
		var navbarWrapper = document.getElementById('navbar-wrapper');
		if (!navbar) return;

		var SCROLL_IN = 80;
		var SCROLL_OUT = 40;
		var COMPACT_GAP = 8;
		var ticking = false;
		var resizeTicking = false;

		function updateCompactLayout() {
			var segments = document.querySelector<HTMLElement>('.navbar-segments');
			var center = document.querySelector<HTMLElement>('.navbar-seg--center');
			var left = document.querySelector<HTMLElement>('.navbar-seg--left');
			var right = document.querySelector<HTMLElement>('.navbar-seg--right');
			if (!segments || !center || !left || !right || !navbar) return;

			var isScrolled = navbar.classList.contains('scrolled');
			var isMobile = window.matchMedia('(max-width: 1023px)').matches;

			if (isMobile) {
				left.style.left = '';
				left.style.transform = '';
				right.style.left = '';
				right.style.right = '';
				right.style.transform = '';
				return;
			}

			var segmentsRect = segments.getBoundingClientRect();
			var centerRect = center.getBoundingClientRect();
			var leftRect = left.getBoundingClientRect();
			var rightRect = right.getBoundingClientRect();

			if (isScrolled) {
				left.style.left = (centerRect.left - segmentsRect.left - COMPACT_GAP - leftRect.width) + 'px';
				left.style.transform = 'translateY(-50%)';
				right.style.left = (centerRect.right - segmentsRect.left + COMPACT_GAP) + 'px';
				right.style.right = 'auto';
				right.style.transform = 'translateY(-50%)';
			} else {
				left.style.left = '0px';
				left.style.transform = 'translateY(-50%)';
				var isFirstRightPosition = right.style.left === '';
				if (isFirstRightPosition) { right.style.transition = 'none'; }
				right.style.left = (segmentsRect.width - rightRect.width) + 'px';
				right.style.right = 'auto';
				right.style.transform = 'translateY(-50%)';
				if (isFirstRightPosition) {
					right.offsetHeight;
					right.style.transition = '';
				}
			}
		}

		function handleScroll() {
			if (!navbar) return;
			var y = window.scrollY;
			var wasScrolled = navbar.classList.contains('scrolled');

			if (y > SCROLL_IN) {
				navbar.classList.add('scrolled');
				if (navbarWrapper) navbarWrapper.classList.add('navbar-scrolled');
			} else if (y < SCROLL_OUT) {
				navbar.classList.remove('scrolled');
				if (navbarWrapper) navbarWrapper.classList.remove('navbar-scrolled');
			}

			var isScrolled = navbar.classList.contains('scrolled');
			if (wasScrolled !== isScrolled || isScrolled) {
				requestAnimationFrame(updateCompactLayout);
			}
			ticking = false;
		}

		window.addEventListener('scroll', function() {
			if (!ticking) {
				requestAnimationFrame(handleScroll);
				ticking = true;
			}
		}, { passive: true });

		window.addEventListener('resize', function() {
			if (!resizeTicking) {
				requestAnimationFrame(function() {
					updateCompactLayout();
					resizeTicking = false;
				});
				resizeTicking = true;
			}
		}, { passive: true });

		handleScroll();
		requestAnimationFrame(updateCompactLayout);
	})();

	// Search shortcut
	function initSearchShortcut() {
		var isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
		var text = isMac ? "⌘K" : "Ctrl K";
		document.querySelectorAll("[data-shortcut]").forEach(function(el) {
			el.textContent = text;
		});
	}

	initSearchShortcut();
	document.addEventListener("astro:page-load", function() {
		initHoverSlider();
		initSearchShortcut();
	});

	// Search button click — 使用事件委托在 document 上，避免 Swup 重复绑定
	const runtimeWin = window as unknown as { __navbarSearchBound?: boolean; __fireflySearchModalController?: { toggle: () => void }; __fireflySearchModalPendingToggle?: boolean };
	if (!runtimeWin.__navbarSearchBound) {
		runtimeWin.__navbarSearchBound = true;
		document.addEventListener("click", function(e) {
			var target = e.target as HTMLElement | null;
			var btn = target?.closest?.("#nav-search-btn");
			if (!btn) return;
			e.stopPropagation();
			// 触发搜索模态框
			if (runtimeWin.__fireflySearchModalController) {
				runtimeWin.__fireflySearchModalController.toggle();
			} else {
				runtimeWin.__fireflySearchModalPendingToggle = true;
			}
		});
	}
})();
</script>

{
	import.meta.env.PROD && (
		<script is:inline data-swup-ignore-script define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}>
			async function loadPagefind() {
				try {
					const response = await fetch(scriptUrl, { method: 'HEAD' });
					if (!response.ok) {
						throw new Error(`Pagefind script not found: ${response.status}`);
					}
					const pagefind = await import(scriptUrl);
					await pagefind.options({ excerptLength: 20 });
					window.pagefind = pagefind;
					document.dispatchEvent(new CustomEvent('pagefindready'));
				} catch (error) {
					console.error('Failed to load Pagefind:', error);
					window.pagefind = {
						search: () => Promise.resolve({ results: [] }),
						options: () => Promise.resolve(),
					};
					document.dispatchEvent(new CustomEvent('pagefindloaderror'));
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', loadPagefind);
			} else {
				loadPagefind();
			}
		</script>
	)
}
