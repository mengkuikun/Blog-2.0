---
import Icon from "@components/common/Icon.astro";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	index: number;
	class?: string;
}

const { link, index, class: className } = Astro.props;

if (!link) {
	return null;
}

// 转换子菜单中的 LinkPreset 为 NavBarLink
const processedLink = {
	...link,
	children: link.children
		?.map((child: NavBarLink | LinkPreset): NavBarLink | null => {
			if (typeof child === "number") {
				if (child in LinkPresets) {
					return LinkPresets[child as LinkPreset];
				}
				return null;
			}
			return child;
		})
		.filter((child): child is NavBarLink => child !== null),
};

const hasChildren = !!processedLink.children && processedLink.children.length > 0;
---

<div
	class:list={["dropdown-container", className]}
	data-dropdown
	data-dropdown-index={index}
>
	{hasChildren ? (
		<button
			aria-label={processedLink.name}
			aria-haspopup="true"
			aria-expanded="false"
			class="btn-plain scale-animation rounded-lg h-9 font-bold px-3 pr-7 active:scale-95 dropdown-trigger relative"
			data-dropdown-trigger
			type="button"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.05rem]" />}
				<span>{processedLink.name}</span>
			</div>
			<Icon
				name="material-symbols:keyboard-arrow-down-rounded"
				class="text-[1.1rem] transition-transform duration-200 dropdown-arrow absolute right-2.5 top-1/2 -translate-y-1/2"
			/>
		</button>
	) : (
		<a
			aria-label={processedLink.name}
			href={processedLink.external ? processedLink.url : url(processedLink.url)}
			target={processedLink.external ? "_blank" : null}
			class="btn-plain scale-animation rounded-lg h-9 font-bold px-3 active:scale-95"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.05rem]" />}
				<span>{processedLink.name}</span>
				{processedLink.external && (
					<Icon
						name="fa7-solid:arrow-up-right-from-square"
						class="text-[0.8rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20"
					/>
				)}
			</div>
		</a>
	)}
</div>
