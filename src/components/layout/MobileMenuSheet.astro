---
import { Icon } from "astro-icon/components";
import { commentConfig, navBarConfig, profileConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

const walineServerURL =
	commentConfig.type === "waline" ? commentConfig.waline?.serverURL || "" : "";

// 移动端菜单完全由 navBarConfig 驱动（LinkPreset 与 NavMenuPanel 一致解析），
// 避免硬编码菜单与桌面端导航配置不同步
const processedLinks = navBarConfig.links.map((link) => {
	const resolved: NavBarLink =
		typeof link === "number" ? LinkPresets[link] : link;
	return {
		...resolved,
		children: resolved.children?.map(
			(child): NavBarLink =>
				typeof child === "number" ? LinkPresets[child] : child,
		),
	};
});
---

<div class="menu-sheet-overlay" id="menu-sheet-overlay" aria-hidden="true"></div>

<div class="menu-sheet" id="menu-sheet" role="dialog" aria-label="菜单">
  <div class="menu-sheet__header">
    <!-- 站长个人资料卡快捷胶囊入口 -->
    <button
      type="button"
      class="menu-sheet__profile-chip"
      id="menu-sheet-profile-btn"
      aria-label="查看站长资料卡"
    >
      <img
        src={profileConfig.avatar?.startsWith("/") ? url(profileConfig.avatar) : profileConfig.avatar || url("/avatar.jpg")}
        alt=""
        class="menu-sheet__profile-avatar-mini"
        loading="lazy"
      />
      <span class="menu-sheet__profile-name">{profileConfig.name}</span>
      <span class="menu-sheet__profile-tag">
        资料卡
        <Icon name="material-symbols:chevron-right-rounded" class="text-xs inline ml-0.5" />
      </span>
    </button>

    <span class="menu-sheet__header-title">菜单</span>
    <button class="menu-sheet__close" id="menu-sheet-close" aria-label="关闭" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6.4 19L5 17.6L10.6 12L5 6.4L6.4 5L12 10.6L17.6 5L19 6.4L13.4 12L19 17.6L17.6 19L12 13.4L6.4 19Z" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <nav class="menu-sheet__nav" aria-label="主导航">
    {processedLinks.map((link) =>
      !link.children || link.children.length === 0 ? (
        <a
          href={link.external ? link.url : url(link.url)}
          class="menu-sheet__row"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener" : undefined}
        >
          <span class="menu-sheet__row-icon"><Icon name={link.icon} /></span>
          <span class="menu-sheet__row-label">{link.name}</span>
          {link.external && <span class="menu-sheet__row-external"><Icon name="material-symbols:open-in-new-rounded" /></span>}
        </a>
      ) : (
        <details class="menu-sheet__group">
          <summary class="menu-sheet__group-header">
            <span class="menu-sheet__row-icon"><Icon name={link.icon} /></span>
            <span class="menu-sheet__row-label">{link.name}</span>
            <span class="menu-sheet__chevron"><Icon name="material-symbols:expand-more-rounded" /></span>
          </summary>
          <div class="menu-sheet__group-body">
            {(link.children ?? []).map((child) => (
              <a href={child.external ? child.url : url(child.url)} class="menu-sheet__subrow" target={child.external ? "_blank" : undefined} rel={child.external ? "noopener" : undefined}>
                <span class="menu-sheet__subrow-icon"><Icon name={child.icon} /></span>
                <span class="menu-sheet__subrow-label">{child.name}</span>
                {child.external && <span class="menu-sheet__subrow-external"><Icon name="material-symbols:open-in-new-rounded" /></span>}
              </a>
            ))}
          </div>
        </details>
      )
    )}
  </nav>
</div>

<script is:inline define:vars={{ walineServerURL }}>
(function() {
  if (walineServerURL) {
    fetch(walineServerURL + "/api/comment?type=count")
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var count = typeof data === "number" ? data : (data && data.data);
        if (count !== undefined) {
          var el = document.getElementById("menu-sheet-comment-count");
          if (el) el.textContent = count;
        }
      })
      .catch(function() {});
  }
})();
</script>

<script is:inline data-swup-ignore-script>
(function() {
  if (window.__mobileMenuSheetScriptInited) return;
  window.__mobileMenuSheetScriptInited = true;

  function closeAllDetails() {
    document.querySelectorAll('#menu-sheet details[open]').forEach(function(d) { d.removeAttribute('open'); });
  }

  // 一次只能打开一个二级菜单
  document.querySelectorAll('#menu-sheet details').forEach(function(detail) {
    detail.addEventListener('toggle', function() {
      if (this.open) {
        document.querySelectorAll('#menu-sheet details[open]').forEach(function(other) {
          if (other !== detail) other.removeAttribute('open');
        });
      }
    });
  });

  // 每次打开卡片时全部收起
  var sheet = document.getElementById('menu-sheet');
  if (sheet) {
    new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.attributeName === 'class' && sheet.classList.contains('is-open')) {
          closeAllDetails();
        }
      });
    }).observe(sheet, { attributes: true, attributeFilter: ['class'] });
  }
})();
</script>
