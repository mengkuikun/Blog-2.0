---
import Icon from "@components/common/Icon.astro";

interface TechItem {
	name: string;
	desc: string;
	icon: string;
	url: string;
	color: string;
	darkColor?: string;
}

interface TechGroup {
	id: string;
	label: string;
	icon: string;
	items: TechItem[];
}

const techGroups: TechGroup[] = [
	{
		id: "core",
		label: "核心框架",
		icon: "material-symbols:code-blocks",
		items: [
			{
				name: "Astro 7",
				desc: "站点骨架，内容驱动的静态框架",
				icon: "simple-icons:astro",
				url: "https://astro.build",
				color: "#ff5d01",
			},
			{
				name: "Svelte 5",
				desc: "交互组件与留言板的界面层",
				icon: "simple-icons:svelte",
				url: "https://svelte.dev",
				color: "#ff3e00",
			},
			{
				name: "TypeScript",
				desc: "全站类型安全",
				icon: "simple-icons:typescript",
				url: "https://www.typescriptlang.org",
				color: "#3178c6",
			},
			{
				name: "Tailwind CSS 4",
				desc: "原子化样式引擎",
				icon: "simple-icons:tailwindcss",
				url: "https://tailwindcss.com",
				color: "#38bdf8",
			},
		],
	},
	{
		id: "motion",
		label: "体验与动效",
		icon: "material-symbols:auto-awesome",
		items: [
			{
				name: "Swup 4",
				desc: "页面无缝过渡，丝滑不闪屏",
				icon: "material-symbols:transition-fade",
				url: "https://swup.js.org",
				color: "#0ea5e9",
			},
			{
				name: "GSAP",
				desc: "动效编排",
				icon: "simple-icons:gsap",
				url: "https://gsap.com",
				color: "#88ce02",
			},
			{
				name: "Pagefind",
				desc: "静态全文搜索",
				icon: "material-symbols:search",
				url: "https://pagefind.app",
				color: "#2563eb",
			},
		],
	},
	{
		id: "content",
		label: "内容与渲染",
		icon: "material-symbols:terminal",
		items: [
			{
				name: "MDX",
				desc: "关于页的组件化内容",
				icon: "simple-icons:mdx",
				url: "https://mdxjs.com",
				color: "#f9ac00",
			},
			{
				name: "Expressive Code",
				desc: "代码块美化",
				icon: "material-symbols:data-object",
				url: "https://expressive-code.com",
				color: "#8b5cf6",
			},
			{
				name: "KaTeX",
				desc: "数学公式渲染",
				icon: "material-symbols:functions",
				url: "https://katex.org",
				color: "#4f6bed",
			},
			{
				name: "Mermaid",
				desc: "流程图与图表",
				icon: "simple-icons:mermaid",
				url: "https://mermaid.js.org",
				color: "#ff3670",
			},
			{
				name: "Waline",
				desc: "评论系统",
				icon: "material-symbols:chat-bubble-outline",
				url: "https://waline.js.org",
				color: "#39a9f5",
			},
		],
	},
	{
		id: "deploy",
		label: "部署与数据",
		icon: "material-symbols:rocket-launch",
		items: [
			{
				name: "GitHub Pages",
				desc: "站点托管",
				icon: "simple-icons:github",
				url: "https://pages.github.com",
				color: "#111111",
				darkColor: "#ffffff",
			},
			{
				name: "EdgeOne",
				desc: "CDN 加速",
				icon: "edgeone",
				url: "https://edgeone.tencent.com",
				color: "#0055d2",
				darkColor: "#2979ff",
			},
			{
				name: "Cloudflare",
				desc: "DNS 与安全防护",
				icon: "simple-icons:cloudflare",
				url: "https://www.cloudflare.com",
				color: "#f38020",
			},
			{
				name: "Umami",
				desc: "隐私友好的访问统计",
				icon: "simple-icons:umami",
				url: "https://umami.is",
				color: "#111111",
				darkColor: "#ffffff",
			},
		],
	},
	{
		id: "engineering",
		label: "工程化",
		icon: "material-symbols:commit",
		items: [
			{
				name: "pnpm",
				desc: "包管理",
				icon: "simple-icons:pnpm",
				url: "https://pnpm.io",
				color: "#f9ad00",
			},
			{
				name: "Biome",
				desc: "Lint 与格式化",
				icon: "simple-icons:biome",
				url: "https://biomejs.dev",
				color: "#6f7bf7",
			},
			{
				name: "Playwright",
				desc: "端到端测试",
				icon: "simple-icons:playwright",
				url: "https://playwright.dev",
				color: "#2ead33",
			},
			{
				name: "GitHub Actions",
				desc: "CI 流水线",
				icon: "simple-icons:githubactions",
				url: "https://github.com/features/actions",
				color: "#2088ff",
			},
		],
	},
];

const totalTech = techGroups.reduce(
	(sum, group) => sum + group.items.length,
	0,
);
---

<section class="about-tech-stack" aria-label={`站点技术栈（共 ${totalTech} 项）`}>
	{techGroups.map((group, index) => (
		<div class="tech-accordion" data-tech-accordion={index === 0 ? "open" : "closed"}>
			<button type="button" class="tech-accordion__head" aria-expanded={index === 0 ? "true" : "false"}>
				<span class="tech-accordion__group-icon" aria-hidden="true"><Icon name={group.icon} /></span>
				<span class="tech-accordion__label">{group.label}</span>
				<span class="tech-accordion__count">{group.items.length} 项</span>
				<Icon name="material-symbols:keyboard-arrow-down-rounded" class="tech-accordion__arrow" aria-hidden="true" />
			</button>
			<div class="tech-accordion__body">
				<div class="tech-accordion__body-inner">
					<div class="tech-accordion__grid">
						{group.items.map((item, itemIndex) => (
							<a
								class="tech-card no-styling"
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${item.name}：${item.desc}`}
								style={`--tech-color: ${item.color};${item.darkColor ? `--tech-color-dark: ${item.darkColor};` : ""}--i: ${itemIndex};`}
							>
								<span class="tech-card__icon" aria-hidden="true">
									{item.icon === "edgeone" ? (
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="EdgeOne">
											<path d="M23.8101 14.138C23.9349 13.4442 24 12.7297 24 12C24 11.3831 23.9535 10.7772 23.8637 10.1854C23.829 9.95674 23.6296 9.792 23.3983 9.792H15.6802C15.4277 9.792 15.2439 9.5525 15.3093 9.30861L16.2229 5.89892C16.2903 5.6471 16.5185 5.472 16.7792 5.472H21.3634C21.668 5.472 21.8488 5.13574 21.6682 4.89047C19.4834 1.9244 15.9664 0 12 0C5.37258 0 0 5.37258 0 12C0 15.0173 1.11361 17.7745 2.95224 19.883C3.14804 20.1076 3.5076 20.0146 3.58436 19.7268L6.23943 9.77025C6.28819 9.58741 6.15038 9.40804 5.96116 9.40804H3.65504C3.40274 9.40804 3.21899 9.16888 3.284 8.9251L4.03273 6.11736C4.0889 5.90673 4.28001 5.76117 4.49796 5.75666C7.01035 5.70465 9.49302 5.04698 11.6975 3.84351C11.9253 3.71913 12.2007 3.92739 12.1338 4.1782L7.24991 22.4929C7.17698 22.7664 7.31303 23.0538 7.57612 23.1582C8.94505 23.7014 10.4377 24 12 24C15.7878 24 19.1656 22.2451 21.3649 19.5039C21.5597 19.2611 21.3809 18.912 21.0696 18.912H13.2365C12.984 18.912 12.8002 18.6725 12.8656 18.4286L13.7792 15.0189C13.8467 14.7671 14.0749 14.592 14.3356 14.592H23.2564C23.5268 14.592 23.7622 14.4042 23.8101 14.138Z" fill="currentColor" />
										</svg>
									) : (
										<Icon name={item.icon} />
									)}
								</span>
								<span class="tech-card__name">{item.name}</span>
								<span class="tech-card__desc">{item.desc}</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	))}
</section>

<script is:inline>
	(function () {
		if (window.__aboutTechAccordionReady) return;
		window.__aboutTechAccordionReady = true;
		document.addEventListener("click", function (e) {
			var head = e.target.closest(".tech-accordion__head");
			if (!head) return;
			var item = head.closest("[data-tech-accordion]");
			if (!item) return;
			var open = item.getAttribute("data-tech-accordion") === "open";
			item.setAttribute("data-tech-accordion", open ? "closed" : "open");
			head.setAttribute("aria-expanded", open ? "false" : "true");
		});
	})();
</script>
