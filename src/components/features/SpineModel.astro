---
import MessageBox from "@/components/common/PioMessageBox.astro";
import { spineModelConfig } from "@/config/pioConfig";
import { url } from "@/utils/url-utils";
---

<!-- Spine Web Player CSS 将在 script 中动态加载 -->{
  spineModelConfig.enable && (
    <div
      id="spine-model-container"
      style={`
      position: fixed;
      ${spineModelConfig.position.corner.includes("right") ? "right" : "left"}: ${spineModelConfig.position.offsetX}px;
      ${spineModelConfig.position.corner.includes("top") ? "top" : "bottom"}: ${spineModelConfig.position.offsetY}px;
      width: ${spineModelConfig.size.width}px;
      height: ${spineModelConfig.size.height}px;
      pointer-events: auto;
      z-index: 1000;
    `}
    >
      <div id="spine-player-container" style="width: 100%; height: 100%;" />
      <div id="spine-error" style="display: none;" />

      <!-- 看板娘悬浮选项工具栏（鼠标靠近时浮现） -->
      <div id="spine-action-toolbar" class="spine-action-toolbar" aria-label="看板娘快捷选项">
        <button
          type="button"
          class="spine-tool-btn"
          id="spine-btn-sync"
          aria-label="刷新留言"
        >
          <svg class="spine-tool-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
          </svg>
          <span class="spine-tooltip" id="spine-sync-tooltip">刷新留言</span>
        </button>
        <button
          type="button"
          class="spine-tool-btn"
          id="spine-btn-dialogue"
          aria-label="留言情报"
        >
          <svg class="spine-tool-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          <span class="spine-tooltip">留言情报</span>
        </button>
        <button
          type="button"
          class="spine-tool-btn"
          id="spine-btn-action"
          aria-label="换个表情"
        >
          <svg class="spine-tool-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span class="spine-tooltip">换个动作</span>
        </button>
        <button
          type="button"
          class="spine-tool-btn"
          id="spine-btn-sleep"
          aria-label="小憩收起"
        >
          <svg class="spine-tool-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6h-6l6 6h-6" />
            <path d="M9 14H5l4 4H5" />
          </svg>
          <span class="spine-tooltip">小憩收起</span>
        </button>
      </div>

      <!-- 唤醒展开浮标（小憩收起时悬挂在露出的右侧边缘） -->
      <button
        type="button"
        id="spine-wake-btn"
        class="spine-wake-btn"
        style="display: none;"
        aria-label="唤醒流萤"
        title="点击或向右拖动唤醒"
      >
        <span class="spine-wake-icon">🌸</span>
        <span class="spine-wake-text">唤醒</span>
        <svg class="spine-wake-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  )
}

<!-- 引入消息框组件 -->
<MessageBox />

<script is:inline define:vars={{ spineModelConfig, modelPath: url(spineModelConfig.model.path), atlasPath: url(spineModelConfig.model.path.replace(".json", ".atlas")), cssPath: url("/pio/static/spine-player.min.css"), jsPath: url("/pio/static/spine-player.min.js") }}>
  // 动态加载 Spine CSS（带本地备用）
  function loadSpineCSS() {
    if (!spineModelConfig.enable) return;

    // 检查是否已经加载
    const existingLink = document.querySelector('link[href*="spine-player"]');
    if (existingLink) return;

    // 首先尝试加载 CDN CSS
    const cdnLink = document.createElement("link");
    cdnLink.rel = "stylesheet";
    cdnLink.href =
      "https://unpkg.com/@esotericsoftware/spine-player@4.2.*/dist/spine-player.min.css";

    // 监听加载失败事件，自动回退到本地文件
    cdnLink.onerror = function () {
      console.warn("⚠️ Spine CSS CDN failed, trying local fallback...");

      // 移除失败的 CDN link
      if (cdnLink.parentNode) {
        cdnLink.parentNode.removeChild(cdnLink);
      }

      // 创建本地备用 CSS link
      const localLink = document.createElement("link");
      localLink.rel = "stylesheet";
      localLink.href = cssPath;
      localLink.onerror = function () {
        console.error("❌ Failed to load Spine CSS");
      };

      document.head.appendChild(localLink);
    };

    document.head.appendChild(cdnLink);
  }

  // 消息框功能已移至公共组件 MessageBox.astro
  let isClickProcessing = false; // 防止重复点击的标志
  let lastClickTime = 0; // 记录最后一次点击时间

  // 全局变量，防止重复初始化
  window.spineModelInitialized = window.spineModelInitialized || false;
  window.spinePlayerInstance = window.spinePlayerInstance || null;

  // 消息显示函数 - 使用公共消息框组件
  function showMessage(message) {
    // 使用公共消息框组件
    if (window.showModelMessage) {
      window.showModelMessage(message, {
        containerId: "spine-model-container",
        displayTime: spineModelConfig.interactive.messageDisplayTime || 3000
      });
    }
  }

  function isGuestbookPage() {
    return (
      Boolean(document.querySelector(".guestbook-page")) ||
      window.location.pathname.startsWith("/guestbook")
    );
  }

  // 更新响应式显示与页面路由可见性
  function updateResponsiveDisplay() {
    if (!spineModelConfig.enable) return;

    const container = document.getElementById("spine-model-container");
    if (!container) return;

    // 检查是否配置了仅在留言板启用
    if (spineModelConfig.onlyOnGuestbook && !isGuestbookPage()) {
      container.style.display = "none";
      if (window.clearModelMessage) {
        window.clearModelMessage();
      }
      return;
    }

    // 检查移动端显示设置
    if (
      spineModelConfig.responsive.hideOnMobile &&
      window.innerWidth <= spineModelConfig.responsive.mobileBreakpoint
    ) {
      container.style.display = "none";
    } else {
      container.style.display = "block";
    }
  }

  // 清理函数
  function cleanupSpineModel() {
    console.log("🧹 Cleaning up existing Spine model...");

    // 清理待机动画循环定时器
    if (window.__spineIdleIntervalId) {
      clearInterval(window.__spineIdleIntervalId);
      window.__spineIdleIntervalId = null;
    }

    // 清理消息显示（使用公共组件）
    if (window.clearModelMessage) {
      window.clearModelMessage();
    }

    // 清理现有的播放器实例
    if (window.spinePlayerInstance) {
      try {
        if (window.spinePlayerInstance.dispose) {
          window.spinePlayerInstance.dispose();
        }
      } catch (e) {
        console.warn("Error disposing spine player:", e);
      }
      window.spinePlayerInstance = null;
    }

    // 清理容器内容
    const playerContainer = document.getElementById("spine-player-container");
    if (playerContainer) {
      playerContainer.innerHTML = "";
    }

    // 重置初始化标志
    window.spineModelInitialized = false;
  }

  async function initSpineModel() {
    if (!spineModelConfig.enable) return;

    // 检查是否仅在留言板启用，如果在其他页面则不加载重型模型资源
    if (spineModelConfig.onlyOnGuestbook && !isGuestbookPage()) {
      const container = document.getElementById("spine-model-container");
      if (container) container.style.display = "none";
      return;
    }

    // 检查移动端显示设置，如果隐藏则不加载运行时
    if (
      spineModelConfig.responsive.hideOnMobile &&
      window.innerWidth <= spineModelConfig.responsive.mobileBreakpoint
    ) {
      console.log("📱 Mobile device detected, skipping Spine model initialization");
      const container = document.getElementById("spine-model-container");
      if (container) container.style.display = "none";
      return;
    }

    // 检查是否已经初始化
    if (window.spineModelInitialized) {
      console.log("⏭️ Spine model already initialized, skipping...");
      return;
    }

    console.log("🎯 Initializing Spine Model...");

    // 先清理可能存在的旧实例
    cleanupSpineModel();

    // 首先加载 CSS
    loadSpineCSS();

    // 加载 Spine Web Player 运行时
    const loadSpineRuntime = () => {
      return new Promise((resolve, reject) => {
        if (typeof window.spine !== "undefined") {
          console.log("✅ Spine runtime already loaded");
          resolve();
          return;
        }

        console.log("📦 Loading Spine runtime...");
        const script = document.createElement("script");
        script.src =
          "https://unpkg.com/@esotericsoftware/spine-player@4.2.*/dist/iife/spine-player.min.js";
        script.onload = () => {
          console.log("✅ Spine runtime loaded from CDN");
          resolve();
        };
        script.onerror = (_error) => {
          console.warn("⚠️ CDN failed, trying local fallback...");

          // 尝试本地回退
          const fallbackScript = document.createElement("script");
          fallbackScript.src = jsPath;
          fallbackScript.onload = () => {
            console.log("✅ Spine runtime loaded from local fallback");
            resolve();
          };
          fallbackScript.onerror = () => {
            reject(new Error("Failed to load Spine runtime"));
          };
          document.head.appendChild(fallbackScript);
        };
        document.head.appendChild(script);
      });
    };

    // 等待 Spine 库加载
    const waitForSpine = () => {
      return new Promise((resolve, reject) => {
        let attempts = 0;
        const maxAttempts = 50;

        const check = () => {
          attempts++;
          if (typeof window.spine !== "undefined" && window.spine.SpinePlayer) {
            console.log("✅ Spine runtime loaded");
            resolve();
          } else if (attempts >= maxAttempts) {
            reject(new Error("Spine runtime loading timeout"));
          } else {
            setTimeout(check, 100);
          }
        };
        check();
      });
    };

    try {
      // 首先加载 Spine 运行时
      await loadSpineRuntime();

      // 然后等待 Spine 对象可用
      await waitForSpine();

      // 标记为已初始化
      window.spineModelInitialized = true;

      // 创建 SpinePlayer
      new window.spine.SpinePlayer("spine-player-container", {
        skeleton: modelPath,
        atlas: atlasPath,
        animation: "idle",
        backgroundColor: "#00000000", // 透明背景
        showControls: false, // 隐藏控件
        alpha: true,
        premultipliedAlpha: false,
        success: (player) => {
          console.log("🎉 Spine model loaded successfully!");

          // 保存播放器实例引用
          window.spinePlayerInstance = player;

          // 初始化完成后设置默认姿态
          setTimeout(() => {
            if (player.skeleton) {
              try {
                player.skeleton.updateWorldTransform();
                player.skeleton.setToSetupPose();
              } catch (e) {
                console.warn("Error positioning skeleton:", e);
              }
            }
          }, 500);

          // 设置交互功能
          if (spineModelConfig.interactive.enabled) {
            const canvas = document.querySelector(
              "#spine-player-container canvas"
            );
            if (canvas) {
              canvas.addEventListener("click", () => {
                // 防抖处理：防止重复点击
                const currentTime = Date.now();
                if (isClickProcessing || currentTime - lastClickTime < 500) {
                  return; // 500ms 内重复点击忽略
                }

                isClickProcessing = true;
                lastClickTime = currentTime;

                // 收起状态下点击模型，直接唤醒展开
                const sleepingContainer = document.getElementById("spine-model-container");
                if (sleepingContainer && sleepingContainer.classList.contains("is-sleeping")) {
                  wakeUp();
                  return;
                }

                // 随机播放点击动画
                const clickAnims =
                  spineModelConfig.interactive.clickAnimations ||
                  (spineModelConfig.interactive.clickAnimation
                    ? [spineModelConfig.interactive.clickAnimation]
                    : []);

                if (clickAnims.length > 0) {
                  try {
                    const randomClickAnim =
                      clickAnims[Math.floor(Math.random() * clickAnims.length)];
                    player.setAnimation(randomClickAnim, false);

                    // 动画播放完成后回到待机状态
                    setTimeout(() => {
                      const idleAnims =
                        spineModelConfig.interactive.idleAnimations;
                      const randomIdle =
                        idleAnims[Math.floor(Math.random() * idleAnims.length)];
                      player.setAnimation(randomIdle, true);
                    }, 2000);
                  } catch (e) {
                    console.warn("Failed to play click animation:", e);
                  }
                }

                // 显示纯粹的日常互动随机台词，遵照用户需求不再混入技术性的留言板条数或刷新时间
                const messages = [...(spineModelConfig.interactive.clickMessages || [])];
                if (messages && messages.length > 0) {
                  const randomMessage =
                    messages[Math.floor(Math.random() * messages.length)];
                  showMessage(randomMessage);
                }

                // 500ms 后重置防抖标志
                setTimeout(() => {
                  isClickProcessing = false;
                }, 500);
              });

              // 设置待机动画循环
              if (spineModelConfig.interactive.idleAnimations.length > 1) {
                window.__spineIdleIntervalId = setInterval(() => {
                  try {
                    const idleAnims =
                      spineModelConfig.interactive.idleAnimations;
                    const randomIdle =
                      idleAnims[Math.floor(Math.random() * idleAnims.length)];
                    player.setAnimation(randomIdle, true);
                  } catch (e) {
                    console.warn("Failed to play idle animation:", e);
                  }
                }, spineModelConfig.interactive.idleInterval);
              }
            }
          }

          console.log("✅ Spine model setup complete!");
        },
        error: (_player, reason) => {
          console.error("❌ Spine model loading error:", reason);

          const errorDiv = document.getElementById("spine-error");
          if (errorDiv) {
            errorDiv.style.display = "block";
            errorDiv.innerHTML = `
              <div style="color: #ff4444; padding: 20px; text-align: center; font-size: 14px;">
                <div>⚠️ Spine 模型加载失败</div>
                <div style="font-size: 12px; margin-top: 8px; color: #888;">${reason}</div>
              </div>
            `;
          }

          const canvas = document.getElementById("spine-canvas");
          if (canvas) canvas.style.display = "none";
        },
      });
    } catch (error) {
      console.error("Spine model initialization error:", error);

      // 重置初始化标志，允许重试
      window.spineModelInitialized = false;

      const errorDiv = document.getElementById("spine-error");
      if (errorDiv) {
        errorDiv.style.display = "block";
        errorDiv.innerHTML = `
          <div style="color: #ff4444; padding: 20px; text-align: center; font-size: 14px;">
            <div>⚠️ Spine 运行时加载失败</div>
            <div style="font-size: 12px; margin-top: 8px; color: #888;">${error instanceof Error ? error.message : "未知错误"}</div>
          </div>
        `;
      }
    }
  }

  // 留言板状态与小助手事件通信
  let latestGuestbookCount = 0;
  let latestSyncedAt = null;
  let hasWelcomedGuestbook = false;
  let isManualSyncing = false;

  function formatSyncTime(ts) {
    if (!ts) return "尚未刷新";
    const now = Date.now();
    const diff = Math.floor((now - ts) / 1000);
    if (diff < 15) return "刚刚";
    if (diff < 60) return `${diff} 秒前`;
    const mins = Math.floor(diff / 60);
    if (mins < 60) return `${mins} 分钟前`;
    const d = new Date(ts);
    const hh = String(d.getHours()).padStart(2, "0");
    const mm = String(d.getMinutes()).padStart(2, "0");
    return `${hh}:${mm}`;
  }

  function updateSyncTooltip() {
    const tooltip = document.getElementById("spine-sync-tooltip");
    if (!tooltip) return;
    const timeText = formatSyncTime(latestSyncedAt);
    tooltip.textContent = `刷新留言 (${timeText})`;
  }

  function initToolbarEvents() {
    const syncBtn = document.getElementById("spine-btn-sync");
    const dialogueBtn = document.getElementById("spine-btn-dialogue");
    const actionBtn = document.getElementById("spine-btn-action");
    const sleepBtn = document.getElementById("spine-btn-sleep");
    const wakeBtn = document.getElementById("spine-wake-btn");

    if (syncBtn && !syncBtn.dataset.bound) {
      syncBtn.dataset.bound = "1";
      syncBtn.addEventListener("mouseenter", updateSyncTooltip);
      syncBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        syncBtn.classList.add("is-spinning");
        isManualSyncing = true;
        window.dispatchEvent(new CustomEvent("guestbook:trigger-sync"));
        showMessage("正在为你检查最新留言哦~ 🌸");
        setTimeout(() => {
          syncBtn.classList.remove("is-spinning");
          updateSyncTooltip();
        }, 1200);
      });
    }

    // 换句台词按钮：专门轮播汇报留言板状态（上次刷新时间、当前总留言条数等）
    let dialogueReportIndex = 0;
    function getGuestbookReportMessage() {
      const syncTimeStr = formatSyncTime(latestSyncedAt);
      const reports = [];

      if (latestGuestbookCount > 0) {
        reports.push(`🌸 报告！留言板目前已汇聚了 ${latestGuestbookCount} 条温暖留言啦~`);
        reports.push(`💬 大家的留言都很有趣呢，现在共有 ${latestGuestbookCount} 条消息哦！`);
      }
      if (latestSyncedAt) {
        reports.push(`💫 上次同步更新是在 ${syncTimeStr} 呢，数据妥妥的~`);
        reports.push(`⏱️ 留言通道运行良好，上次检查是 ${syncTimeStr} 哦！`);
      }
      if (latestGuestbookCount > 0 && latestSyncedAt) {
        reports.push(`📊 留言情报速递：共 ${latestGuestbookCount} 条留言 · 上次同步: ${syncTimeStr} ✨`);
      }
      reports.push(`🔔 只要有新的留言送达，流萤都会第一时间叮咚提醒你哦~`);
      reports.push(`💡 小贴士：点击右侧或引用留言可以快速回复，回车键直接发送！`);

      const selected = reports[dialogueReportIndex % reports.length];
      dialogueReportIndex++;
      return selected;
    }

    if (dialogueBtn && !dialogueBtn.dataset.bound) {
      dialogueBtn.dataset.bound = "1";
      dialogueBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const msg = getGuestbookReportMessage();
        showMessage(msg);
      });
    }

    if (actionBtn && !actionBtn.dataset.bound) {
      actionBtn.dataset.bound = "1";
      actionBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const player = window.spinePlayerInstance;
        if (!player) return;
        const anims = spineModelConfig.interactive.clickAnimations || [];
        if (anims.length > 0) {
          const randomAnim = anims[Math.floor(Math.random() * anims.length)];
          try {
            player.setAnimation(randomAnim, false);
            setTimeout(() => {
              const idleAnims = spineModelConfig.interactive.idleAnimations || ["idle"];
              const randomIdle = idleAnims[Math.floor(Math.random() * idleAnims.length)];
              player.setAnimation(randomIdle, true);
            }, 2000);
          } catch (err) {
            console.warn("Failed to switch animation:", err);
          }
        }
      });
    }

    if (sleepBtn && !sleepBtn.dataset.bound) {
      sleepBtn.dataset.bound = "1";
      sleepBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        putToSleep();
      });
    }

    if (wakeBtn && !wakeBtn.dataset.bound) {
      wakeBtn.dataset.bound = "1";
      wakeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        wakeUp();
      });
    }

    initDragEvents();
  }

  // 控制 SpinePlayer WebGL 渲染暂停与恢复（有效节约 CPU/GPU 开销）
  function pauseSpinePlayer() {
    const player = window.spinePlayerInstance;
    if (player && typeof player.pause === "function") {
      try {
        player.pause();
      } catch (_) {}
    }
  }

  function resumeSpinePlayer() {
    const player = window.spinePlayerInstance;
    if (player && typeof player.play === "function") {
      try {
        player.play();
      } catch (_) {}
    }
  }

  // 待机动画循环控制
  function startIdleLoop(player) {
    if (!player || spineModelConfig.interactive.idleAnimations.length <= 1) return;
    if (window.__spineIdleIntervalId) {
      clearInterval(window.__spineIdleIntervalId);
    }
    window.__spineIdleIntervalId = setInterval(() => {
      try {
        const container = document.getElementById("spine-model-container");
        if (container && container.classList.contains("is-sleeping")) return;
        const idleAnims = spineModelConfig.interactive.idleAnimations;
        const randomIdle = idleAnims[Math.floor(Math.random() * idleAnims.length)];
        player.setAnimation(randomIdle, true);
      } catch (e) {
        console.warn("Failed to play idle animation:", e);
      }
    }, spineModelConfig.interactive.idleInterval);
  }

  // 唤醒流萤核心逻辑
  function wakeUp() {
    const container = document.getElementById("spine-model-container");
    const wakeBtn = document.getElementById("spine-wake-btn");
    if (!container) return;
    container.classList.remove("is-sleeping");
    container.style.transform = "";
    container.style.transition = "";
    if (wakeBtn) wakeBtn.style.display = "none";
    resumeSpinePlayer();
    showMessage("流萤醒来啦！很高兴继续陪着你~ ✨");

    const player = window.spinePlayerInstance;
    if (player) {
      try {
        const wakeAnims = ["emoji_0", "emoji_3", "idle"];
        const anim = wakeAnims[Math.floor(Math.random() * wakeAnims.length)];
        player.setAnimation(anim, false);
        setTimeout(() => {
          const idleAnims = spineModelConfig.interactive.idleAnimations || ["idle"];
          player.setAnimation(idleAnims[0] || "idle", true);
          startIdleLoop(player);
        }, 2000);
      } catch (err) {
        console.warn("Wake animation error:", err);
      }
    }
  }

  // 小憩收起核心逻辑
  function putToSleep() {
    const container = document.getElementById("spine-model-container");
    const wakeBtn = document.getElementById("spine-wake-btn");
    if (!container) return;
    container.classList.add("is-sleeping");
    if (wakeBtn) wakeBtn.style.display = "flex";
    if (window.clearModelMessage) window.clearModelMessage();
    // 小憩时暂停待机定时器与渲染循环，彻底消除后台空转消耗
    if (window.__spineIdleIntervalId) {
      clearInterval(window.__spineIdleIntervalId);
      window.__spineIdleIntervalId = null;
    }
    pauseSpinePlayer();
  }

  // 支持在收起状态下按住露出的流萤身体向右拖拽拉出（Drag to pull out）
  let isDraggingSleep = false;
  let dragStartX = 0;
  let dragMoved = false;

  function initDragEvents() {
    const container = document.getElementById("spine-model-container");
    if (!container || container.dataset.dragBound) return;
    container.dataset.dragBound = "1";

    container.addEventListener("pointerdown", (e) => {
      if (!container.classList.contains("is-sleeping")) return;
      isDraggingSleep = true;
      dragMoved = false;
      dragStartX = e.clientX;
      container.style.transition = "none";
      try {
        container.setPointerCapture(e.pointerId);
      } catch (_) {}
    });

    container.addEventListener("pointermove", (e) => {
      if (!isDraggingSleep) return;
      const deltaX = e.clientX - dragStartX;
      if (Math.abs(deltaX) > 6) {
        dragMoved = true;
      }
      if (deltaX > 0) {
        // 向右拖动：从基础偏移 -75px 往 0px 靠拢
        const currentOffset = Math.min(10, -75 + deltaX);
        container.style.transform = `translateX(${currentOffset}px) scale(0.85)`;
      }
    });

    const finishDrag = (e) => {
      if (!isDraggingSleep) return;
      isDraggingSleep = false;
      container.style.transition = "";
      try {
        container.releasePointerCapture(e.pointerId);
      } catch (_) {}

      const deltaX = e.clientX - dragStartX;
      if (container.classList.contains("is-sleeping")) {
        // 向右拖动超过 20px，或者用户点击而未大幅移动，均直接唤醒展开
        if (deltaX > 20 || !dragMoved) {
          wakeUp();
        } else {
          container.style.transform = "";
        }
      }
    };

    container.addEventListener("pointerup", finishDrag);
    container.addEventListener("pointercancel", finishDrag);
  }

  window.addEventListener("guestbook:status", (event) => {
    if (!spineModelConfig.guestbookAssistant) return;
    if (!isGuestbookPage()) return;
    const detail = (event && "detail" in event ? event.detail : null) || {};

    if (detail.lastSyncedAt) {
      latestSyncedAt = Number(detail.lastSyncedAt);
      updateSyncTooltip();
    }

    if (detail.type === "synced") {
      const count = Number(detail.totalMessages) || 0;
      latestGuestbookCount = count;
      if (isManualSyncing) {
        isManualSyncing = false;
        showMessage(`已同步至最新数据啦~ (上次检查: ${formatSyncTime(latestSyncedAt)}) 💫`);
      } else if (!hasWelcomedGuestbook && count > 0) {
        hasWelcomedGuestbook = true;
        setTimeout(() => {
          if (isGuestbookPage()) {
            showMessage(`🌸 欢迎来到留言板！这里已汇聚了 ${count} 条留言啦~`);
          }
        }, 1200);
      }
    } else if (detail.type === "new-message") {
      if (isGuestbookPage()) {
        showMessage("🔔 叮咚！刚刚有新的留言送达，快去看看吧！");
      }
    } else if (detail.type === "sent") {
      if (isGuestbookPage()) {
        showMessage("🚀 留言发送成功！感谢你的温暖分享~ 💖");
      }
    }
  });

  // 导航路由流转处理器
  function handleNavigation() {
    updateResponsiveDisplay();
    if (isGuestbookPage()) {
      initToolbarEvents();
      if (!window.spineModelInitialized) {
        initSpineModel();
      } else {
        const container = document.getElementById("spine-model-container");
        if (container && !container.classList.contains("is-sleeping")) {
          resumeSpinePlayer();
        }
      }
    } else {
      hasWelcomedGuestbook = false;
      pauseSpinePlayer();
      if (window.clearModelMessage) {
        window.clearModelMessage();
      }
    }
  }

  // 监听页面卸载事件，清理资源
  window.addEventListener("beforeunload", cleanupSpineModel);

  // 单例注册全局事件，防止 Swup SPA 跨页重复监听（符合 CLAUDE.md §8 与 §11）
  if (!window.__spineGlobalEventsBound) {
    window.__spineGlobalEventsBound = true;

    // 监听 Swup 页面切换事件
    document.addEventListener("swup:content:replaced", () => {
      setTimeout(handleNavigation, 80);
    });

    // 监听 popstate 事件（浏览器前进后退）
    window.addEventListener("popstate", () => {
      setTimeout(handleNavigation, 80);
    });

    // 监听窗口大小变化
    window.addEventListener("resize", updateResponsiveDisplay);

    // 监听标签页可见性：切换到后台标签时自动暂停 WebGL 渲染，切回前台恢复
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        pauseSpinePlayer();
      } else {
        const container = document.getElementById("spine-model-container");
        if (container && !container.classList.contains("is-sleeping") && isGuestbookPage()) {
          resumeSpinePlayer();
        }
      }
    });
  }

  // 页面加载完成后初始化
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initToolbarEvents();
      initSpineModel();
    });
  } else {
    initToolbarEvents();
    initSpineModel();
  }
</script>

