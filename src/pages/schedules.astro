---
import { getCollection } from "astro:content";
import { Lunar } from "lunar-javascript";
import PageTitle from "@/components/common/PageTitle.astro";
import SchedulesView from "@/components/schedules/SchedulesView.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const raw = await getCollection("schedules");
// 服务端预换算农历→当年阳历，消首屏闪烁：isLunar 无 date 的生日在此算好 solar
const now = new Date();
const curYear = now.getFullYear();
function solarFor(entry: (typeof raw)[number], y: number): Date | null {
	const d = entry.data as unknown as Record<string, unknown>;
	if (!d.isLunar) return null;
	const lm = d.lunarMonth as number | undefined;
	const ld = d.lunarDay as number | undefined;
	const leap = Boolean(d.lunarLeap);
	if (!lm || !ld) return null;
	try {
		const l = Lunar.fromYmd(y, lm, ld, leap);
		const s = l.getSolar();
		return new Date(s.getYear(), s.getMonth() - 1, s.getDay());
	} catch {
		return null;
	}
}
const schedules = raw.map((e) => {
	const solar = solarFor(e, curYear);
	if (solar) {
		// 用当年阳历覆盖 date，供首屏直接正确渲染；lunar 字段保留
		return { ...e, data: { ...e.data, date: solar } } as typeof e;
	}
	// 非农历但 date 缺失（如旧占位）给回退
	if (!e.data.date) {
		return {
			...e,
			data: { ...e.data, date: new Date(curYear, 0, 1) },
		} as typeof e;
	}
	return e;
});

const url = Astro.url;
const qy = url.searchParams.get("y");
const qm = url.searchParams.get("m");
let year = qy ? Number.parseInt(qy, 10) : now.getFullYear();
let month = qm ? Number.parseInt(qm, 10) : now.getMonth() + 1;
if (!(month >= 1 && month <= 12)) {
	year = now.getFullYear();
	month = now.getMonth() + 1;
}
const selected =
	url.searchParams.get("d") ||
	`${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
---
<MainGridLayout title="日程" description="日历与日程">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div data-pagefind-body class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <PageTitle
        icon="material-symbols:calendar-today-outline"
        title="日历"
        description="用日历管理你的日程、生日与纪念日，重要时刻一目了然"
      />
      <SchedulesView
        client:load
        schedules={schedules}
        initialYear={year}
        initialMonth={month}
        initialSelected={selected}
      />
    </div>
  </div>
</MainGridLayout>
<style>
/* 保留原有容器样式以兼容 Svelte 内部 :global 选择器 */
</style>
