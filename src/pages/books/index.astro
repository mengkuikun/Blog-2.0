---
import { getCollection } from "astro:content";
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import Bookshelf from "@/components/pages/books/Bookshelf.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import { removeFileExtension } from "@/utils/url-utils";

if (!siteConfig.pages.books) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(new Date());

const customBangumi = await getCollection("bangumi");

const bookItems = customBangumi
	.filter((item) => item.data.category === "book")
	.sort((a, b) => {
		const dateA = a.data.published?.getTime() || 0;
		const dateB = b.data.published?.getTime() || 0;
		return dateB - dateA;
	})
	.map((item) => {
		const imageSrc =
			typeof item.data.image === "string"
				? item.data.image
				: item.data.image.src;
		const slug = removeFileExtension(item.id);
		const link = `/books/${slug}/`;
		// 子分类来自 bangumi/book/ 下的目录名（book/分类/书名）；根目录下的条目归为未分类
		const idParts = item.id.replace(/\\/g, "/").split("/");
		const category = idParts.length >= 3 ? idParts[1] : "未分类";

		return {
			title: item.data.title,
			coverImage: imageSrc,
			link,
			status: item.data.status,
			score: item.data.score || 0,
			category,
		};
	});

const readingCount = bookItems.filter((b) => b.status === 3).length;
const readCount = bookItems.filter((b) => b.status === 2).length;
const wishCount = bookItems.filter((b) => b.status === 1).length;

// 书籍分类筛选（子分类来自 bangumi/book/ 下的目录名；根目录下的条目归为未分类）
const categoryCounts: Record<string, number> = {};
for (const book of bookItems) {
	categoryCounts[book.category] = (categoryCounts[book.category] || 0) + 1;
}
const bookTabs = [
	{
		value: "all",
		label: i18n(I18nKey.bangumiFilterAll),
		count: bookItems.length,
	},
	...Object.entries(categoryCounts).map(([value, count]) => ({
		value,
		label: value,
		count,
	})),
];

// 状态筛选（读过/在读/想读/搁置/抛弃，与影视页一致）
const statusMap: Record<number, string> = {
	1: "wish",
	2: "collect",
	3: "doing",
	4: "on_hold",
	5: "dropped",
};
const statusCounts: Record<string, number> = {};
for (const book of bookItems) {
	const s = statusMap[book.status] || "unknown";
	statusCounts[s] = (statusCounts[s] || 0) + 1;
}
const statusFilters = [
	{
		value: "all",
		label: i18n(I18nKey.bangumiFilterAll),
		count: bookItems.length,
	},
	{
		value: "collect",
		label: i18n(I18nKey.bangumiFilterBookRead),
		count: statusCounts.collect || 0,
	},
	{
		value: "doing",
		label: i18n(I18nKey.bangumiFilterBookReading),
		count: statusCounts.doing || 0,
	},
	{
		value: "wish",
		label: i18n(I18nKey.bangumiFilterBookWish),
		count: statusCounts.wish || 0,
	},
	{
		value: "on_hold",
		label: i18n(I18nKey.bangumiFilterOnHold),
		count: statusCounts.on_hold || 0,
	},
	{
		value: "dropped",
		label: i18n(I18nKey.bangumiFilterDropped),
		count: statusCounts.dropped || 0,
	},
];
---

<MainGridLayout title={i18n(I18nKey.booksTitle)} description={i18n(I18nKey.booksSubtitle)}>
	<div class="books-page-wrapper flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div data-pagefind-body class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
					<!-- Page header -->
		<header class="books-header relative w-full mb-6">
			<PageTitle
				icon="material-symbols:auto-stories"
				title={i18n(I18nKey.booksTitle)}
				description={i18n(I18nKey.booksSubtitle)}
			/>
			<div class="flex items-center gap-4 mt-2">
				<p class="text-xs text-neutral-400 dark:text-neutral-500">
					{i18n(I18nKey.bangumiLastUpdated)} {buildTime}
				</p>
				<div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
					<span class="flex items-center gap-1">
						<span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
						{i18n(I18nKey.bookshelfRead)} {readCount}
					</span>
					<span class="flex items-center gap-1">
						<span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
						{i18n(I18nKey.bookshelfReading)} {readingCount}
					</span>
					<span class="flex items-center gap-1">
						<span class="w-2 h-2 rounded-full bg-sky-500 inline-block"></span>
						{i18n(I18nKey.bookshelfWantRead)} {wishCount}
					</span>
				</div>
			</div>
		</header>

			{bookItems.length > 0 ? (
				<Bookshelf books={bookItems} tabs={bookTabs} statusFilters={statusFilters} />
			) : (
				<div class="w-full p-12 text-center">
					<Icon name="material-symbols:auto-stories" class="text-6xl text-neutral-300 dark:text-neutral-600 mb-4" />
					<p class="text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.booksNoData)}</p>
				</div>
			)}
		</div>
	</div>

	<Comment customPath="/books/" />
</MainGridLayout>

<style>
	.books-page-wrapper {
		border-radius: var(--radius-large);
	}

	.books-header {
		animation: fadeSlideIn 0.4s ease-[var(--ease-standard)] both;
	}

	.books-icon {
		transition: transform 0.2s ease-[var(--ease-standard)];
	}
	.books-icon:hover {
		transform: scale(1.05);
	}

	@keyframes fadeSlideIn {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 640px) {
		.card-base {
			padding-left: 1rem;
			padding-right: 1rem;
			padding-top: 1.5rem;
			padding-bottom: 1.5rem;
		}
	}
</style>
