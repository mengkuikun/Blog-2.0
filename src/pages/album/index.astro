---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BounceCards from "@/components/features/BounceCards.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const imgbedUrl = import.meta.env.PUBLIC_IMAGEBED_URL || "";
const imgbedToken = import.meta.env.PUBLIC_IMAGEBED_API_TOKEN || "";

// 从图床获取预览图片
async function fetchImgbedPreview(folder: string): Promise<string[]> {
	if (!imgbedUrl || !imgbedToken || !folder) return [];
	try {
		const resp = await fetch(
			`${imgbedUrl}/api/manage/list?dir=${encodeURIComponent(folder)}&count=4`,
			{ headers: { Authorization: `Bearer ${imgbedToken}` } },
		);
		if (!resp.ok) return [];
		const data = (await resp.json()) as {
			files?: { name: string; metadata?: { FileType?: string } }[];
		};
		const isImage = (f: { name?: string; metadata?: { FileType?: string } }) => {
			const ext = (f.name || "").split(".").pop()?.toLowerCase() ?? "";
			return (
				f.metadata?.FileType?.startsWith("image/") ||
				["jpg", "jpeg", "png", "gif", "webp", "avif", "svg", "bmp"].includes(ext)
			);
		};
		return (data.files || [])
			.filter(isImage)
			.map((f) => `${imgbedUrl}/file/${f.name}`);
	} catch {
		return [];
	}
}

const albums = await getCollection("album", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const sortedAlbums = albums.sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// 为图床相册获取预览图（并行请求，避免串行等待）
const imgbedPreviewCache = new Map<string, string[]>();
const imgbedAlbums = sortedAlbums.filter((a) => a.data.imgbedFolder);
if (imgbedAlbums.length > 0) {
	const results = await Promise.all(
		imgbedAlbums.map((a) =>
			a.data.imgbedFolder ? fetchImgbedPreview(a.data.imgbedFolder) : [],
		),
	);
	imgbedAlbums.forEach((a, i) => {
		if (results[i].length > 0) imgbedPreviewCache.set(a.id, results[i]);
	});
}

const allTags = [
	...new Set(sortedAlbums.flatMap((a) => a.data.tags || [])),
].sort();

const earliestDate =
	sortedAlbums.length > 0
		? sortedAlbums[sortedAlbums.length - 1].data.date
		: new Date();
const latestDate =
	sortedAlbums.length > 0 ? sortedAlbums[0].data.date : new Date();

const formatDateRange = (start: Date, end: Date) => {
	const format = (d: Date) =>
		`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
	return `${format(start)} - ${format(end)}`;
};

function getPreviewPhotos(album: CollectionEntry<"album">) {
	if (album.data.imgbedFolder) {
		return imgbedPreviewCache.get(album.id) || [];
	}
	const photos = album.data.photos || [];
	return photos.slice(0, 4);
}
---

<MainGridLayout title="相册" description="记录生活中的美好瞬间">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
    <!-- 头部横幅 -->
    <div class="relative w-full mb-10">
      <div class="flex items-center gap-3 mb-5">
        <Icon name="material-symbols:photo-album" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
        <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">我的相册</div>
      </div>

      <!-- 统计信息 -->
      <div class="flex items-center gap-3 mt-5">
        <div class="stat-pill">
          <Icon name="material-symbols:photo-album" class="text-sm" />
          <span class="font-semibold">{sortedAlbums.length}</span>
          <span class="text-neutral-500 dark:text-neutral-400">相册</span>
        </div>
        <div class="stat-pill">
          <Icon name="material-symbols:calendar-month" class="text-sm" />
          <span class="text-neutral-400 dark:text-neutral-500">{formatDateRange(earliestDate, latestDate)}</span>
        </div>
      </div>

    </div>

    <!-- 标签筛选 -->
    {sortedAlbums.length > 0 && allTags.length > 0 && (
      <div class="tools-tab-wrapper">
        <div class="tools-tab-pill" data-album-filter>
          <div class="tools-tab-indicator album-filter-indicator" style="opacity:0;"></div>
          <button data-tag="all" class="tools-tab-btn tools-tab-btn-active">全部</button>
          {allTags.map((tag) => (
            <button data-tag={tag} class="tools-tab-btn tools-tab-btn-inactive">{tag}</button>
          ))}
        </div>
      </div>
    )}

    <!-- 相册网格 -->
    <div class="albums-grid">
      {sortedAlbums.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {sortedAlbums.map((album, index) => {
            const previewPhotos = getPreviewPhotos(album);
            const photoCount = album.data.photos?.length || 0;
            const photoUrls = previewPhotos.map((p: any) => typeof p === 'string' ? p : p.src);
            // 根据照片数量生成散开样式（卡片 120px，容器 340px）
            const cardTransforms = photoUrls.length === 1
              ? ["rotate(-2deg)"]
              : photoUrls.length === 2
                ? ["rotate(-4deg) translate(-40px)", "rotate(4deg) translate(40px)"]
                : photoUrls.length === 3
                  ? ["rotate(-5deg) translate(-70px)", "rotate(0deg)", "rotate(5deg) translate(70px)"]
                  : photoUrls.length === 4
                    ? ["rotate(5deg) translate(-90px)", "rotate(0deg) translate(-30px)", "rotate(-5deg) translate(30px)", "rotate(-5deg) translate(90px)"]
                    : ["rotate(8deg) translate(-110px)", "rotate(4deg) translate(-55px)", "rotate(-2deg)", "rotate(-8deg) translate(55px)", "rotate(3deg) translate(110px)"];
            return (
              <a
                href={`/album/${album.id}/`}
                class="album-card group onload-animation"
                data-tags={(album.data.tags || []).join(",")}
                data-album-card
                style={`animation-delay: calc(var(--content-delay) + ${index * 80}ms)`}
              >
                <!-- BounceCards 照片展示 -->
                <div class="bounce-stack">
                  {photoUrls.length > 0 ? (
                    <BounceCards
                      id={`bounce-${album.id}`}
                      images={photoUrls}
                      containerWidth={340}
                      containerHeight={190}
                      animationDelay={0.3 + index * 0.1}
                      animationStagger={0.08}
                      enableHover={true}
                      transformStyles={cardTransforms}
                    />
                  ) : (
                    <div class="empty-placeholder">
                      <Icon name="material-symbols:add-photo-alternate-outline" class="text-4xl" />
                    </div>
                  )}
                  {photoCount > 4 && !album.data.imgbedFolder && (
                    <div class="photo-badge">+{photoCount - 4}</div>
                  )}
                  {album.data.imgbedFolder && (
                    <div class="photo-badge"><Icon name="material-symbols:cloud" class="text-xs" /> 图床</div>
                  )}
                </div>

                <!-- 相册信息 -->
                <div class="card-body">
                  <h3 class="card-title">{album.data.title}</h3>
                  <div class="card-meta">
                    <span class="meta-item">
                      <Icon name="material-symbols:calendar-today" class="text-xs" />
                      {album.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}
                    </span>
                    <span class="meta-item">
                      <Icon name="material-symbols:imagesmode" class="text-xs" />
                      {album.data.imgbedFolder ? "图床相册" : `${photoCount} 张`}
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="w-full p-12 text-center">
          <Icon name="material-symbols:photo-album-outline" class="text-6xl text-neutral-300 dark:text-neutral-600 mb-4" />
          <p class="text-neutral-500 dark:text-neutral-400">还没有创建任何相册哦~</p>
          <p class="text-sm text-neutral-400 dark:text-neutral-500 mt-2">快去记录生活中的美好瞬间吧！</p>
        </div>
      )}
    </div>

    <!-- 分页控件（统一样式 3/9 虚线） -->
    <nav class="album-pagination" data-album-pagination hidden aria-label="相册分页">
      <button type="button" class="album-page-btn" data-page-prev aria-label="上一页">
        <Icon name="material-symbols:chevron-left-rounded" class="text-[1.75rem]" />
      </button>
      <div class="bg-[var(--card-bg)] flex items-center rounded-lg px-3.5 h-11 gap-1.5 border border-dashed border-[var(--line-divider)] shadow-sm">
        <span class="album-current-page text-sm font-bold text-[var(--primary)] tabular-nums">1</span>
        <span class="text-sm text-[var(--content-meta)]">/</span>
        <span class="album-total-pages text-sm font-bold text-[var(--content-meta)] tabular-nums">1</span>
      </div>
      <button type="button" class="album-page-btn" data-page-next aria-label="下一页">
        <Icon name="material-symbols:chevron-right-rounded" class="text-[1.75rem]" />
      </button>
    </nav>

    </div>
  </div>

  <!-- 标签筛选 + 分页 -->
  <script is:inline>
  (function() {
    if (window.__albumFilterReady) return;
    window.__albumFilterReady = true;

    var PAGE_SIZE = 6;
    var currentTag = "all";
    var currentPage = 1;

    function getCards() {
      return Array.prototype.slice.call(document.querySelectorAll("[data-album-card]"));
    }

    function getFiltered() {
      return getCards().filter(function(card) {
        if (currentTag === "all") return true;
        var tags = (card.getAttribute("data-tags") || "").split(",").filter(Boolean);
        return tags.indexOf(currentTag) !== -1;
      });
    }

    function render() {
      var filtered = getFiltered();
      var totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      var start = (currentPage - 1) * PAGE_SIZE;
      var end = start + PAGE_SIZE;
      var visibleSet = new Set(filtered.slice(start, end));

      getCards().forEach(function(card) {
        if (visibleSet.has(card)) {
          card.style.display = "";
          card.classList.remove("album-card-fade-in");
          void card.offsetHeight;
          card.classList.add("album-card-fade-in");
        } else {
          card.style.display = "none";
          card.classList.remove("album-card-fade-in");
        }
      });

      renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
      var nav = document.querySelector("[data-album-pagination]");
      if (!nav) return;
      if (totalPages <= 1) { nav.hidden = true; return; }
      nav.hidden = false;

      var prev = nav.querySelector("[data-page-prev]");
      var next = nav.querySelector("[data-page-next]");
      if (prev) prev.disabled = currentPage <= 1;
      if (next) next.disabled = currentPage >= totalPages;

      var curEl = nav.querySelector(".album-current-page");
      var totalEl = nav.querySelector(".album-total-pages");
      if (curEl) curEl.textContent = String(currentPage);
      if (totalEl) totalEl.textContent = String(totalPages);
    }

    function updateIndicator(container, button) {
      var indicator = container.querySelector(".album-filter-indicator");
      if (!indicator || !button) return;
      var parentRect = container.getBoundingClientRect();
      var btnRect = button.getBoundingClientRect();
      indicator.style.left = (btnRect.left - parentRect.left) + "px";
      indicator.style.top = (btnRect.top - parentRect.top) + "px";
      indicator.style.width = btnRect.width + "px";
      indicator.style.height = btnRect.height + "px";
      indicator.style.opacity = "1";
    }

    // 标签筛选点击
    document.addEventListener("click", function(e) {
      var btn = e.target.closest("[data-album-filter] .tools-tab-btn");
      if (!btn) return;
      var container = btn.closest("[data-album-filter]");
      if (!container) return;

      var filters = container.querySelectorAll(".tools-tab-btn");
      filters.forEach(function(f) {
        f.classList.remove("tools-tab-btn-active");
        f.classList.add("tools-tab-btn-inactive");
      });
      btn.classList.remove("tools-tab-btn-inactive");
      btn.classList.add("tools-tab-btn-active");

      currentTag = btn.getAttribute("data-tag") || "all";
      currentPage = 1;
      updateIndicator(container, btn);
      render();
    });

    // 分页点击
    document.addEventListener("click", function(e) {
      var nav = e.target.closest("[data-album-pagination]");
      if (!nav) return;

      var go = e.target.closest("[data-page-go]");
      if (go) {
        currentPage = parseInt(go.dataset.pageGo, 10) || 1;
      } else if (e.target.closest("[data-page-prev]")) {
        currentPage = Math.max(1, currentPage - 1);
      } else if (e.target.closest("[data-page-next]")) {
        currentPage = currentPage + 1;
      } else {
        return;
      }

      render();
      document.querySelector(".albums-grid")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    function init() {
      var container = document.querySelector("[data-album-filter]");
      if (container) {
        var activeBtn = container.querySelector(".tools-tab-btn-active") || container.querySelector('[data-tag="all"]');
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            if (activeBtn) updateIndicator(container, activeBtn);
          });
        });
      }
      currentPage = 1;
      render();
    }

    init();
    document.addEventListener("astro:page-load", init);
    window.addEventListener("resize", function() {
      var container = document.querySelector("[data-album-filter]");
      if (!container) return;
      var activeBtn = container.querySelector(".tools-tab-btn-active");
      if (activeBtn) updateIndicator(container, activeBtn);
    });
  })();
  </script>
</MainGridLayout>

<style>
  .albums-grid {
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 统计胶囊 */
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--page-bg);
    border: 1px solid var(--line-divider);
    border-radius: 50px;
    font-size: 13px;
    color: var(--deep-text);
    transition: border-color 0.2s ease;
  }
  .stat-pill:hover {
    border-color: var(--primary);
  }
  .stat-pill :global(svg) {
    color: var(--primary);
  }

  /* ============================================
     相册卡片 — 画廊墙风格
     灵感来源：美术馆挂画 + 照片墙
     特点：厚画框 + 投影 + 标签胶带 + 铭牌式标题
     ============================================ */
  .album-card {
    --ac-frame: var(--deep-text);
    --ac-mat: var(--page-bg);
    --ac-shadow: color-mix(in srgb, var(--deep-text) 12%, transparent);

    display: flex;
    flex-direction: column;
    background: var(--ac-mat);
    /* 厚画框效果：双层边框模拟画框切面 */
    border: 3px solid var(--ac-frame);
    outline: 1px solid color-mix(in srgb, var(--ac-frame) 15%, transparent);
    outline-offset: 4px;
    border-radius: 6px;
    overflow: visible;
    position: relative;
    /* 画框投影：右下偏移 + 扩散 */
    box-shadow:
      5px 5px 0 0 var(--ac-shadow),
      5px 5px 0 1px color-mix(in srgb, var(--ac-frame) 8%, transparent);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.4s ease;
  }

  :root.dark .album-card {
    --ac-shadow: color-mix(in srgb, var(--deep-text) 25%, transparent);
  }

  .album-card:hover {
    /* 悬停：画框微微抬起，投影拉远 */
    transform: translateY(-8px) rotate(-0.5deg);
    box-shadow:
      8px 10px 0 0 var(--ac-shadow),
      8px 10px 0 1px color-mix(in srgb, var(--ac-frame) 8%, transparent),
      0 20px 40px color-mix(in srgb, var(--deep-text) 8%, transparent);
  }

  /* BounceCards 堆叠区域 — 画框内的衬板 */
  .bounce-stack {
    position: relative;
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    /* 衬板纹理：极淡的十字纹 */
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--line-divider) 8%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--line-divider) 8%, transparent) 1px, transparent 1px);
    background-size: 20px 20px;
    border-radius: 3px 3px 0 0;
  }

  @media (max-width: 640px) {
    .bounce-stack { height: 150px; }
  }

  .bounce-stack :global(.bounce-card) {
    width: 100px;
    border-width: 3px;
    border-radius: 14px;
  }

  /* 照片数量徽章 — 胶片卷标签 */
  .photo-badge {
    position: absolute;
    bottom: 12px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--ac-frame);
    color: var(--ac-mat);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 3px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 10;
  }

  .empty-placeholder {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    color: var(--content-meta);
    opacity: 0.15;
  }

  /* 信息区域 — 画框下方的铭牌 */
  .card-body {
    padding: 14px 16px 18px;
    /* 顶部分割线模拟画框底边 */
    border-top: 1px solid color-mix(in srgb, var(--line-divider) 40%, transparent);
    margin-top: 2px;
  }

  .card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--deep-text);
    margin-bottom: 8px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
  }

  .album-card:hover .card-title {
    color: var(--primary);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--content-meta);
    letter-spacing: 0.02em;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .meta-item :global(svg) {
    opacity: 0.5;
    font-size: 13px;
  }

  .card-meta {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; color: var(--content-meta);
  }

  .meta-item {
    display: flex; align-items: center; gap: 4px;
  }

  @media (max-width: 640px) {
    .polaroid-stack { height: 180px; }
    .stat-pill { padding: 6px 12px; font-size: 12px; }
  }

  /* --- 标签筛选胶囊 --- */
  .tools-tab-wrapper {
    margin-bottom: 1.5rem;
  }

  .tools-tab-pill {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.375rem;
    border-radius: 1rem;
    border: 2px solid var(--deep-text);
  }
  :root.dark .tools-tab-pill {
    border-color: var(--deep-text);
  }

  .tools-tab-indicator {
    position: absolute;
    border-radius: 9999px;
    background: var(--deep-text);
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                top 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }
  :root.dark .tools-tab-indicator {
    background: var(--deep-text);
  }

  .tools-tab-btn {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: none;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    background: transparent;
    transition: color 0.2s;
    flex-shrink: 0;
    font-family: inherit;
    color: var(--deep-text);
  }
  :root.dark .tools-tab-btn {
    color: var(--deep-text);
  }

  .tools-tab-btn-active {
    color: var(--page-bg);
    cursor: default;
  }
  :root.dark .tools-tab-btn-active {
    color: var(--page-bg);
  }

  .tools-tab-btn-inactive:hover {
    opacity: 0.7;
  }

  /* 筛选动画 */
  .album-card-fade-in {
    animation: albumFadeInUp 0.35s ease-out both;
  }
  @keyframes albumFadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- 分页控件 --- */
  .album-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0 0.5rem;
  }

  .album-page-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-divider);
    border-radius: 0.5rem;
    background: var(--card-bg);
    color: var(--primary);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.15s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .album-page-btn:hover:not(:disabled) {
    background: var(--btn-card-bg-hover);
    color: var(--primary);
    transform: none;
  }
  .album-page-btn:active {
    transform: scale(0.95);
  }
  .album-page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .album-page-nums {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }

  .album-page-num {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line-divider);
    border-radius: 0.5rem;
    background: var(--card-bg);
    color: var(--content-meta);
    font-size: 0.875rem;
    font-weight: 700;
