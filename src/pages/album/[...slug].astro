---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Comment from "@/components/comment/index.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const albums = await getCollection("album");
	return albums.map((album) => ({
		params: { slug: album.id },
		props: { album },
	}));
}

const { album } = Astro.props;
const isImgbed = !!album.data.imgbedFolder;

const photos = (album.data.photos || []).map(
	(photo: string | { src?: string; alt?: string }, index: number) => {
		let src: string;
		let alt: string;
		if (typeof photo === "string") {
			src = photo;
			alt = "";
		} else {
			src = photo.src || "";
			alt = photo.alt || "";
		}
		return { src, alt, index };
	},
);

// 图床 API 配置（用于客户端动态加载）
const imgbedUrl = import.meta.env.PUBLIC_IMAGEBED_URL || "";
const imgbedToken = import.meta.env.PUBLIC_IMAGEBED_API_TOKEN || "";
---

<MainGridLayout title={album.data.title} description={album.data.subtitle || `${album.data.title} - 相册`}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
    <!-- 相册头部 -->
    <div class="album-hero" style={photos.length > 0 ? `--hero-bg: url(${photos[0].src})` : ""}>
      <div class="album-hero-overlay"></div>
      <div class="album-hero-content">
        <a href="/album/" class="album-back-btn" aria-label="返回相册列表">
          <Icon name="material-symbols:arrow-left-rounded" />
          <span>返回相册</span>
        </a>
        <h1 class="album-title" data-pagefind-meta="title" data-pagefind-weight="10">{album.data.title}</h1>
        {album.data.subtitle && (
          <p class="album-subtitle">{album.data.subtitle}</p>
        )}
        <div class="album-meta-row">
          <span class="album-meta-chip" id="photo-count-meta">
            <Icon name="material-symbols:imagesmode" />
            <span id="photo-count-text">{isImgbed ? "图床相册" : `${photos.length} 张照片`}</span>
          </span>
          <span class="album-meta-chip">
            <Icon name="material-symbols:calendar-today" />
            {album.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
        </div>
      </div>
    </div>

    <!-- 瀑布流画廊 -->
    <div class="gallery-section" id="gallery-section">
      {isImgbed ? (
        <div id="imgbed-gallery-wrap"
          data-url={imgbedUrl}
          data-token={imgbedToken}
          data-folder={album.data.imgbedFolder}>
          <div class="imgbed-loading" id="imgbed-loading">
            <div class="spinner"></div>
            <span class="text-neutral-500 dark:text-neutral-400" id="imgbed-status">正在加载图片...</span>
          </div>
        </div>
      ) : photos.length > 0 ? (
        <div class="masonry" id="masonry-grid">
          {photos.map((p: any) => (
            <div class="masonry-item" data-index={p.index}>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </div>
          ))}
        </div>
        <div class="load-more-sentinel" id="load-more-sentinel">
          <div class="load-more-spinner">
            <div class="gallery-spinner"></div>
            <span class="load-more-text">加载中...</span>
          </div>
        </div>
      ) : (
        <div class="empty-state">
          <Icon name="material-symbols:photo-album-outline" class="text-6xl text-neutral-300 dark:text-neutral-600 mb-4" />
          <p class="text-neutral-500 dark:text-neutral-400">这个相册还没有照片哦~</p>
        </div>
      )}
    </div>

    <!-- 评论区 -->
    <div id="album-comments" class="mt-6">
      <Comment customPath={`/album/${album.id}/`} />
    </div>
    </div>
  </div>

  <!-- 灯箱（共用） -->
  <div class="lightbox" id="lightbox" role="dialog" aria-label="图片查看器">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <button class="lightbox-close" id="lightbox-close" aria-label="关闭">
      <Icon name="material-symbols:close-rounded" />
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="上一张">
      <Icon name="material-symbols:chevron-left-rounded" />
    </button>
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="下一张">
      <Icon name="material-symbols:chevron-right-rounded" />
    </button>
    <div class="lightbox-img-wrap" id="lightbox-img-wrap">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-counter" id="lightbox-counter"></div>
  </div>

  <!-- 灯箱 + 分批加载 脚本 -->
  <script is:inline define:vars={{ isImgbed, imgbedUrl, imgbedToken, imgbedFolder: album.data.imgbedFolder, staticPhotos: photos.map(p => p.src) }}>
  (function() {
    var COLS = window.innerWidth <= 768 ? 2 : 3;
    var BATCH_SIZE = COLS * 3; // 每批 3 行
    var BATCH_DELAY = 1500;
    var allSrcs = staticPhotos.slice();
    var loadedCount = 0;
    var isLoading = false;
    var allLoaded = false;

    // ---- 灯箱 ----
    var lightbox = document.getElementById("lightbox");
    var lbImg = document.getElementById("lightbox-img");
    var lbCounter = document.getElementById("lightbox-counter");
    var lbWrap = document.getElementById("lightbox-img-wrap");
    var currentIndex = 0;
    var isOpen = false;
    var touchStartX = 0;

    function openLightbox(index) { currentIndex = index; isOpen = true; updateLightboxImg(); lightbox.classList.add("active"); document.body.style.overflow = "hidden"; }
    function closeLightbox() { isOpen = false; lightbox.classList.remove("active"); document.body.style.overflow = ""; }
    function updateLightboxImg() { if (!allSrcs[currentIndex]) return; lbImg.src = allSrcs[currentIndex]; lbCounter.textContent = (currentIndex + 1) + " / " + allSrcs.length; }
    function navigateLightbox(dir) { currentIndex = (currentIndex + dir + allSrcs.length) % allSrcs.length; updateLightboxImg(); }

    document.addEventListener("click", function(e) {
      var item = e.target.closest(".masonry-item");
      if (!item || isOpen) return;
      var img = item.querySelector("img");
      if (!img) return;
      var src = img.src || img.getAttribute("src");
      var idx = allSrcs.indexOf(src);
      if (idx === -1) return;
      openLightbox(idx);
    });
    document.getElementById("lightbox-backdrop").addEventListener("click", closeLightbox);
    document.getElementById("lightbox-close").addEventListener("click", closeLightbox);
    document.getElementById("lightbox-prev").addEventListener("click", function() { navigateLightbox(-1); });
    document.getElementById("lightbox-next").addEventListener("click", function() { navigateLightbox(1); });
    document.addEventListener("keydown", function(e) { if (!isOpen) return; if (e.key === "Escape") closeLightbox(); if (e.key === "ArrowLeft") navigateLightbox(-1); if (e.key === "ArrowRight") navigateLightbox(1); });
    lbWrap.addEventListener("touchstart", function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    lbWrap.addEventListener("touchend", function(e) { var dx = e.changedTouches[0].clientX - touchStartX; if (Math.abs(dx) > 50) navigateLightbox(dx > 0 ? -1 : 1); }, { passive: true });

    // ---- 分批加载 ----
    var grid = document.getElementById("masonry-grid");
    var sentinel = document.getElementById("load-more-sentinel");
    var observer = null;

    var roundRobin = 0; // 轮询计数器

    function createMasonryItem(src) {
      var item = document.createElement("div");
      item.className = "masonry-item";
      var img = document.createElement("img");
      img.src = src;
      img.loading = "lazy";
      item.appendChild(img);
      return item;
    }

    function getNextCol() {
      var cols = grid.querySelectorAll(".masonry-col");
      var col = cols[roundRobin % cols.length];
      roundRobin++;
      return col;
    }

    function showBatch() {
      if (isLoading || allLoaded) return;
      var remaining = allSrcs.length - loadedCount;
      if (remaining <= 0) { allLoaded = true; if (sentinel) sentinel.classList.add("hidden"); return; }

      isLoading = true;
      if (sentinel) sentinel.classList.remove("hidden");

      setTimeout(function() {
        var batch = allSrcs.slice(loadedCount, loadedCount + BATCH_SIZE);
        batch.forEach(function(src) {
          getNextCol().appendChild(createMasonryItem(src));
        });
        loadedCount += batch.length;
        isLoading = false;

        if (loadedCount >= allSrcs.length) {
          allLoaded = true;
          if (sentinel) sentinel.classList.add("hidden");
        } else if (isSentinelVisible()) {
          // sentinel 仍在视口内，继续加载下一批
          showBatch();
        }
      }, BATCH_DELAY);
    }

    // 检查 sentinel 是否在视口内
    function isSentinelVisible() {
      if (!sentinel) return false;
      var rect = sentinel.getBoundingClientRect();
      return rect.top < window.innerHeight + 300;
    }

    // IntersectionObserver 监测 sentinel
    function setupObserver() {
      if (!sentinel || !("IntersectionObserver" in window)) return;
      if (observer) observer.disconnect();
      observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting && !isLoading && !allLoaded) {
            showBatch();
          }
        });
      }, { rootMargin: "300px" });
      observer.observe(sentinel);
    }
    setupObserver();

    // ---- 静态相册：把已有图片分配到列中 ----
    if (!isImgbed) {
      var existingItems = Array.prototype.slice.call(grid.querySelectorAll(".masonry-item"));
      // 清空网格，创建列容器
      grid.innerHTML = "";
      for (var c = 0; c < COLS; c++) {
        var col = document.createElement("div");
        col.className = "masonry-col";
        grid.appendChild(col);
      }
      var cols = grid.querySelectorAll(".masonry-col");
      // 分配前 BATCH_SIZE 个到列中（轮询），其余标记 batch-hidden
      for (var i = 0; i < existingItems.length; i++) {
        if (i < BATCH_SIZE) {
          cols[i % cols.length].appendChild(existingItems[i]);
        } else {
          existingItems[i].classList.add("batch-hidden");
          grid.appendChild(existingItems[i]); // 隐藏的放 grid 里暂存
        }
      }
      loadedCount = Math.min(BATCH_SIZE, existingItems.length);
      allSrcs = staticPhotos.slice();
      if (loadedCount >= allSrcs.length) { allLoaded = true; if (sentinel) sentinel.classList.add("hidden"); }

      // 覆盖 showBatch：把隐藏的项目分配到列中
      showBatch = function() {
        if (isLoading || allLoaded) return;
        isLoading = true;
        if (sentinel) sentinel.classList.remove("hidden");
        setTimeout(function() {
          var hidden = Array.prototype.slice.call(grid.querySelectorAll(".masonry-item.batch-hidden"));
          var count = Math.min(BATCH_SIZE, hidden.length);
          for (var j = 0; j < count; j++) {
            hidden[j].classList.remove("batch-hidden");
            cols[roundRobin % cols.length].appendChild(hidden[j]);
            roundRobin++;
          }
          loadedCount += count;
          isLoading = false;
          if (grid.querySelectorAll(".masonry-item.batch-hidden").length === 0) {
            allLoaded = true;
            if (sentinel) sentinel.classList.add("hidden");
          } else if (isSentinelVisible()) {
            showBatch();
          }
        }, BATCH_DELAY);
      };
    }

    // ---- 图床动态加载 ----
    if (isImgbed) {
      var wrap = document.getElementById("imgbed-gallery-wrap");
      var loading = document.getElementById("imgbed-loading");
      var statusEl = document.getElementById("imgbed-status");
      var countText = document.getElementById("photo-count-text");

      async function fetchAndRender() {
        if (!imgbedUrl || !imgbedToken) { if (statusEl) statusEl.textContent = "未配置图床 API Token"; return; }
        try {
          var allFiles = [], start = 0;
          while (true) {
            var url = imgbedUrl + "/api/manage/list?dir=" + encodeURIComponent(imgbedFolder) + "&start=" + start + "&count=100";
            var resp = await fetch(url, { headers: { "Authorization": "Bearer " + imgbedToken } });
            if (!resp.ok) throw new Error("HTTP " + resp.status);
            var data = await resp.json();
            var files = (data.files || []).filter(function(f) {
              var ext = (f.name || "").split(".").pop().toLowerCase();
              return (f.metadata && f.metadata.FileType && f.metadata.FileType.startsWith("image/")) || ["jpg", "jpeg", "png", "gif", "webp", "avif", "svg", "bmp"].indexOf(ext) !== -1;
            });
            allFiles = allFiles.concat(files);
            if (statusEl) statusEl.textContent = "正在加载图片... " + allFiles.length + " 张";
            if (!data.files || data.files.length < 100) break;
            start += 100;
          }
          if (allFiles.length === 0) { if (loading) loading.innerHTML = '<p class="text-neutral-500 dark:text-neutral-400">图床文件夹中没有图片</p>'; return; }
          allSrcs = allFiles.map(function(f) { return imgbedUrl + "/file/" + f.name; });
          if (countText) countText.textContent = allSrcs.length + " 张照片";
          // 设置 hero 背景图
          if (allSrcs.length > 0) {
            var hero = document.querySelector(".album-hero");
            if (hero) hero.style.setProperty("--hero-bg", "url(" + allSrcs[0] + ")");
          }
          if (loading) loading.remove();
          // 创建网格（含列容器）和加载指示器
          grid = document.createElement("div");
          grid.className = "masonry";
          grid.id = "masonry-grid";
          for (var c = 0; c < COLS; c++) {
            var col = document.createElement("div");
            col.className = "masonry-col";
            grid.appendChild(col);
          }
          wrap.appendChild(grid);
          sentinel = document.createElement("div");
          sentinel.className = "load-more-sentinel";
          sentinel.id = "load-more-sentinel";
          sentinel.innerHTML = '<div class="load-more-spinner"><div class="gallery-spinner"></div><span class="load-more-text">加载中...</span></div>';
          wrap.appendChild(sentinel);
          // 重新绑定 observer
          setupObserver();
          // 渲染首批
          showBatch();
        } catch (e) {
          if (statusEl) statusEl.textContent = "加载失败: " + e.message;
        }
      }
      fetchAndRender();
    }
  })();
  </script>

  <style>
    /* Hero 头部 */
    .album-hero {
      position: relative; border-radius: 16px; overflow: hidden;
      margin-bottom: 24px; min-height: 200px;
      display: flex; align-items: flex-end;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      background-size: cover; background-position: center;
    }
    .album-hero[style*="--hero-bg"] {
      background-image: var(--hero-bg);
    }
    .album-hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);
    }
    .album-hero-content {
      position: relative; z-index: 2;
      padding: 24px 28px; width: 100%;
    }

    /* 返回按钮 */
    .album-back-btn {
      display: inline-flex; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.8); text-decoration: none;
      font-size: 13px; font-weight: 500;
      padding: 5px 14px; border-radius: 8px;
      background: rgba(255,255,255,0.12);
      backdrop-filter: blur(8px);
      transition: all 0.2s;
      margin-bottom: 14px;
    }
    .album-back-btn:hover {
      background: rgba(255,255,255,0.25); color: #fff;
    }
    .album-back-btn :global(svg) { width: 18px; height: 18px; color: rgba(255,255,255,0.9); }

    /* 标题 */
    .album-title {
      font-size: 2rem; font-weight: 700;
      color: #fff;
      margin: 0 0 6px 0; line-height: 1.2;
      text-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    /* 副标题 */
    .album-subtitle {
      font-size: 0.9375rem; color: rgba(255,255,255,0.75);
      margin: 0 0 16px 0; line-height: 1.5;
    }

    /* 元信息胶囊 */
    .album-meta-row {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }
    .album-meta-chip {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 14px; border-radius: 20px;
      font-size: 12px; font-weight: 500;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(6px);
      color: rgba(255,255,255,0.9);
    }
    .album-meta-chip :global(svg) {
      font-size: 14px; color: rgba(255,255,255,0.8);
    }

    /* 瀑布流 — 固定列容器，避免新图片影响已有布局 */
    :global(.gallery-section) { min-height: 300px; }
    :global(.masonry) {
      display: flex; gap: 12px;
    }
    :global(.masonry-col) {
      flex: 1; display: flex; flex-direction: column; gap: 12px;
    }
    :global(.masonry-item) {
      border-radius: 12px; overflow: hidden; cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    :global(.masonry-item:hover) {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    :root.dark :global(.masonry-item:hover) {
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }
    :global(.masonry-item img) {
      width: 100%; display: block;
      transition: transform 0.35s ease;
    }
    :global(.masonry-item:hover img) {
      transform: scale(1.03);
    }
    :global(.masonry-item.batch-hidden) {
      display: none;
    }

    /* 加载更多指示器 */
    :global(.load-more-sentinel) {
      display: flex; justify-content: center; padding: 32px 0;
    }
    :global(.load-more-sentinel.hidden) {
      display: none;
    }
    :global(.load-more-spinner) {
      display: flex; align-items: center; gap: 10px;
      color: var(--content-meta); font-size: 14px;
      padding: 10px 24px;
      background: var(--card-bg);
      border-radius: 40px;
      border: 1px solid var(--border);
    }
    :global(.gallery-spinner) {
      width: 20px; height: 20px; flex-shrink: 0;
      border: 2.5px solid var(--line-divider);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    :global(.load-more-text) {
      font-size: 13px; color: var(--content-meta);
    }

    @media (max-width: 768px) {
      :global(.masonry) { gap: 8px; }
      :global(.masonry-col) { gap: 8px; }
      :global(.masonry-item) { border-radius: 8px; }
      .album-hero { min-height: 160px; border-radius: 12px; margin-bottom: 16px; }
      .album-hero-content { padding: 18px 20px; }
      .album-title { font-size: 1.5rem; }
      .album-meta-row { gap: 6px; }
      .album-meta-chip { padding: 4px 10px; font-size: 11px; }
    }

    /* 图床加载状态 */
    .imgbed-loading {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 12px; min-height: 300px;
    }
    .imgbed-loading .spinner {
      width: 32px; height: 32px;
      border: 3px solid var(--line-divider); border-top-color: var(--primary);
      border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .empty-state { text-align: center; padding: 60px 20px; }

    /* 灯箱 */
    .lightbox {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
    }
    .lightbox.active { opacity: 1; pointer-events: all; }
    .lightbox-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.88); backdrop-filter: blur(8px); }
    .lightbox-close {
      position: absolute; top: 16px; right: 16px; z-index: 10;
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(255,255,255,0.15); border: none;
      color: #fff; font-size: 24px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.3); }
    .lightbox-nav {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
      width: 48px; height: 48px; border-radius: 50%;
      background: rgba(255,255,255,0.12); border: none;
      color: #fff; font-size: 28px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s, transform 0.2s;
    }
    .lightbox-nav:hover { background: rgba(255,255,255,0.25); }
    .lightbox-prev { left: 16px; }
    .lightbox-next { right: 16px; }
    .lightbox-img-wrap {
      position: relative; z-index: 5;
      max-width: 90vw; max-height: 85vh;
      display: flex; align-items: center; justify-content: center;
    }
    .lightbox-img-wrap img {
      max-width: 90vw; max-height: 85vh;
      object-fit: contain; border-radius: 8px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .lightbox-counter {
      position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 10;
      background: rgba(0,0,0,0.6); color: #fff;
      padding: 6px 16px; border-radius: 20px;
      font-size: 13px; font-weight: 500; backdrop-filter: blur(4px);
    }
    @media (max-width: 640px) {
      .lightbox-nav { width: 40px; height: 40px; font-size: 22px; }
      .lightbox-prev { left: 8px; }
      .lightbox-next { right: 8px; }
      .lightbox-close { top: 12px; right: 12px; }
    }
  </style>
</MainGridLayout>
