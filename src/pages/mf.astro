---
const targetUrl =
	"/posts/实用教程/2026-10-03-基于musicfree搭建全功能个人音乐平台/#手把手保姆级实战指南";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>正在前往 MusicFree 实战指南...</title>
		<meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={targetUrl} />
		<script is:inline define:vars={{ targetUrl }}>
			// 顶层立即执行 replace 无感秒跳，不留中间页历史记录
			window.location.replace(targetUrl);
		</script>
		<style>
			:root {
				--bg-color: #121212;
				--text-color: #a3a3a3;
				--accent-color: #3b82f6;
			}
			@media (prefers-color-scheme: light) {
				:root {
					--bg-color: #f8fafc;
					--text-color: #64748b;
					--accent-color: #2563eb;
				}
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			html,
			body {
				width: 100%;
				height: 100%;
				background-color: var(--bg-color);
				color: var(--text-color);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}
			.redirect-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				opacity: 0.85;
			}
			.spinner {
				width: 2rem;
				height: 2rem;
				border: 3px solid rgba(120, 120, 120, 0.2);
				border-top-color: var(--accent-color);
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
			}
			.tip-text {
				font-size: 0.875rem;
				letter-spacing: 0.05em;
			}
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
		</style>
	</head>
	<body>
		<div class="redirect-box">
			<div class="spinner"></div>
			<div class="tip-text">正在前往 MusicFree 实战指南...</div>
		</div>
	</body>
</html>
