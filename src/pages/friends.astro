---
import { getCollection, getEntry, render } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import { domainToUnicode } from "node:url";
import { removeFileExtension } from "@utils/url-utils";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import FriendCard from "@components/features/FriendCard.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 从 content/friends 目录读取友链数据，按权重排序
const friendsEntries = await getCollection("friends");
const items = friendsEntries
	.filter((item) => item.data.enabled !== false)
	.sort((a, b) => (b.data.weight || 0) - (a.data.weight || 0));

// 新朋友：按添加日期（added）降序取最近 3 个。
// 禁止用文件 mtime 兜底：CI 全新 clone 时所有文件 mtime 都等于构建时刻，
// 会让缺 added 的旧友链永远霸占"新朋友"区块（2026-09 线上事故根因）
const missingAdded = items.filter((item) => !item.data.added);
if (missingAdded.length > 0) {
	console.warn(
		`[friends] ${missingAdded.length} 个友链缺少 added 字段，不参与"新朋友"排序：${missingAdded.map((item) => item.id).join("、")}`,
	);
}
const latestItems = [...items]
	.sort(
		(a, b) => (b.data.added?.getTime() ?? 0) - (a.data.added?.getTime() ?? 0),
	)
	.slice(0, 3);

// 新朋友区块独立展示后，从分组中排除，避免同一站点出现两次
const latestIds = new Set(latestItems.map((item) => item.id));

// 我的朋友们 / 更多伙伴（group 缺省为 other）
const myFriends = items.filter(
	(item) =>
		(item.data.group ?? "other") === "friend" && !latestIds.has(item.id),
);
const moreFriends = items.filter(
	(item) =>
		(item.data.group ?? "other") !== "friend" && !latestIds.has(item.id),
);

// 友链墓碑（纪念下线的友链）：目录不存在或无数据时不调用 getCollection（避免 ENOENT 崩溃与 Astro 空集合警告），区块自动隐藏
const tombstonesDir = path.join(process.cwd(), "src", "content", "tombstones");
const hasTombstones =
	fs.existsSync(tombstonesDir) &&
	fs.readdirSync(tombstonesDir).some((f) => f.endsWith(".md"));
const tombstoneEntries = hasTombstones ? await getCollection("tombstones") : [];

// 站点截图：public/assets/friends-shots/{contentId}.webp，不存在则不传（卡片退化为纯头像卡）
const shotsDir = path.join(process.cwd(), "public", "assets", "friends-shots");
const shotExists = (id: string) =>
	fs.existsSync(path.join(shotsDir, `${removeFileExtension(id)}.webp`));

// 域名（还原为 Unicode 显示，避免 IDN 域名显示成 xn-- punycode；取不到时回退空串）
const hostOf = (siteurl: string) => {
	try {
		const url = new URL(siteurl);
		const hostname = domainToUnicode(url.hostname);
		return url.port ? `${hostname}:${url.port}` : hostname;
	} catch {
		return "";
	}
};

// 页面标题和描述
const title = i18n(I18nKey.friends);
const description = i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) relative min-h-32"
  >
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <Icon name="material-symbols:group" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
            <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {title}
            </h1>
          </div>
          <button
            id="btn-add-friend"
            class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-medium hover:opacity-85 transition-opacity cursor-pointer"
          >
            <Icon name="material-symbols:person-add-rounded" class="text-base" />
            添加友链
          </button>
        </div>
        {
          description && (
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              {description}
            </p>
          )
        }
      </div>

      <!-- 新朋友：最近添加的 3 个 -->
      {
        latestItems.length > 0 && (
          <section class="friend-section">
            <div class="friend-group-head">
              <div>
                <h2 class="friend-group-title">
                  {i18n(I18nKey.friendsLatestTitle)}
                </h2>
                <p class="friend-group-desc">{i18n(I18nKey.friendsShiningDesc).replace("{n}", String(latestItems.length))}</p>
              </div>
              <span class="friend-group-badge">{latestItems.length} {i18n(I18nKey.friendsSites)}</span>
            </div>
            <div class="friends-grid" data-friends-grid>
              {
                latestItems.map((item) => (
                  <FriendCard
                    title={item.data.title}
                    href={item.data.siteurl}
                    imgurl={item.data.imgurl}
                    desc={item.data.desc}
                    screenshot={shotExists(item.id) ? `/assets/friends-shots/${removeFileExtension(item.id)}.webp` : undefined}
                    host={hostOf(item.data.siteurl)}
                  />
                ))
              }
            </div>
          </section>
        )
      }

      <!-- 我的朋友们 -->
      {
        myFriends.length > 0 && (
          <section class="friend-section mt-8">
            <div class="friend-group-head">
              <div>
                <h2 class="friend-group-title">
                  {i18n(I18nKey.friendsMyFriendsTitle)}
                </h2>
                <p class="friend-group-desc">{i18n(I18nKey.friendsShiningDesc).replace("{n}", String(myFriends.length))}</p>
              </div>
              <span class="friend-group-badge">{myFriends.length} {i18n(I18nKey.friendsSites)}</span>
            </div>
            <div class="friends-grid" data-friends-grid>
              {
                myFriends.map((item) => (
                  <FriendCard
                    title={item.data.title}
                    href={item.data.siteurl}
                    imgurl={item.data.imgurl}
                    desc={item.data.desc}
                    screenshot={shotExists(item.id) ? `/assets/friends-shots/${removeFileExtension(item.id)}.webp` : undefined}
                    host={hostOf(item.data.siteurl)}
                  />
                ))
              }
            </div>
          </section>
        )
      }

      <!-- 更多伙伴 -->
      {
        moreFriends.length > 0 && (
          <section class="friend-section mt-8">
            <div class="friend-group-head">
              <div>
                <h2 class="friend-group-title">
                  {i18n(I18nKey.friendsMoreTitle)}
                </h2>
                <p class="friend-group-desc">{i18n(I18nKey.friendsShiningDesc).replace("{n}", String(moreFriends.length))}</p>
              </div>
              <span class="friend-group-badge">{moreFriends.length} {i18n(I18nKey.friendsSites)}</span>
            </div>
            <div class="friends-grid" data-friends-grid>
              {
                moreFriends.map((item) => (
                  <FriendCard
                    title={item.data.title}
                    href={item.data.siteurl}
                    imgurl={item.data.imgurl}
                    desc={item.data.desc}
                    screenshot={shotExists(item.id) ? `/assets/friends-shots/${removeFileExtension(item.id)}.webp` : undefined}
                    host={hostOf(item.data.siteurl)}
                  />
                ))
              }
            </div>
          </section>
        )
      }

      <!-- 友链墓碑：纪念因失联/关闭而下线的友链 -->
      {
        tombstoneEntries.length > 0 && (
          <section class="tombstone-section">
            <h2 class="tombstone-title">{i18n(I18nKey.friendsTombstone)}</h2>
            <div class="tombstone-desc">
              <blockquote>
                <p>{i18n(I18nKey.friendsTombstoneDesc)}</p>
              </blockquote>
            </div>
            <div class="tombstone-list">
              {
                tombstoneEntries.map((entry) => (
                  <span class="tombstone-item">
                    {entry.data.avatar && <img class="tombstone-avatar" src={entry.data.avatar} alt="" loading="lazy" />}
                    <span class="tombstone-name">{entry.data.title}</span>
                  </span>
                ))
              }
            </div>
          </section>
        )
      }

      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </div>
  </div>

  <!-- 评论区（负 margin 抵消评论卡片的 p-8 顶部 padding，收紧与上方内容的间距） -->
  <div class="-mt-6">
    <Comment post={friendsPost} customPath="/friends/" />
  </div>

  <!-- 友链悬浮大图预览 — portal 单例，光标跟随与视口边缘自适应（仅桌面 hover） -->
  <script is:inline>
    (function() {
      if (window.__friendPreviewReady) return;
      window.__friendPreviewReady = true;

      var OFFSET = 16;
      var PADDING = 8;
      var hideTimer = null;
      var lastMouseX = 0;
      var lastMouseY = 0;

      function canHover() {
        return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      }

      function ensurePreview() {
        var el = document.getElementById("friend-preview");
        if (el) return el;
        el = document.createElement("div");
        el.id = "friend-preview";
        el.setAttribute("aria-hidden", "true");
        el.hidden = true;
        var img = document.createElement("img");
        img.alt = "";
        img.decoding = "async";
        img.addEventListener("load", function() {
          if (el.classList.contains("is-visible")) {
            updatePosition(lastMouseX, lastMouseY);
          }
        });
        el.appendChild(img);
        document.body.appendChild(el);
        return el;
      }

      function getPreview() {
        return document.getElementById("friend-preview");
      }

      function updatePosition(clientX, clientY) {
        var el = getPreview();
        if (!el) return;
        var rect = el.getBoundingClientRect();
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var left = clientX + OFFSET;
        var top = clientY + OFFSET;

        // 超出右侧视口时翻转至光标左侧
        if (left + rect.width > vw - PADDING) {
          left = clientX - rect.width - OFFSET;
        }
        if (left < PADDING) {
          left = PADDING;
        }

        // 超出底部视口时贴紧下边缘向上延伸
        if (top + rect.height > vh - PADDING) {
          top = Math.max(PADDING, vh - rect.height - PADDING);
        }
        if (top < PADDING) {
          top = PADDING;
        }

        el.style.left = left + "px";
        el.style.top = top + "px";
      }

      function showPreview(card, clientX, clientY) {
        if (!canHover()) return;
        var src = card.dataset.screenshot;
        if (!src || card.classList.contains("friend-card--no-shot")) return;

        var el = ensurePreview();
        var img = el.querySelector("img");
        if (img.getAttribute("src") !== src) {
          img.src = src;
        }

        if (hideTimer) {
          clearTimeout(hideTimer);
          hideTimer = null;
        }

        el.hidden = false;
        el.classList.add("is-visible");
        lastMouseX = clientX;
        lastMouseY = clientY;
        updatePosition(clientX, clientY);
      }

      function hidePreview() {
        var el = getPreview();
        if (!el) return;
        el.classList.remove("is-visible");
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function() {
          if (!el.classList.contains("is-visible")) {
            el.hidden = true;
          }
        }, 200);
      }

      function bindEvents() {
        if (!canHover()) return;
        ensurePreview();

        document.addEventListener("mouseover", function(e) {
          var card = e.target && e.target.closest ? e.target.closest(".friend-card[data-screenshot]") : null;
          if (!card || card.classList.contains("friend-card--no-shot")) return;
          showPreview(card, e.clientX, e.clientY);
        });

        document.addEventListener("mouseout", function(e) {
          var card = e.target && e.target.closest ? e.target.closest(".friend-card[data-screenshot]") : null;
          if (!card) return;
          var nextCard = e.relatedTarget && e.relatedTarget.closest ? e.relatedTarget.closest(".friend-card[data-screenshot]") : null;
          if (nextCard === card) return;
          if (nextCard && !nextCard.classList.contains("friend-card--no-shot")) return;
          hidePreview();
        });

        document.addEventListener("mousemove", function(e) {
          var el = getPreview();
          if (el && el.classList.contains("is-visible")) {
            lastMouseX = e.clientX;
            lastMouseY = e.clientY;
            updatePosition(e.clientX, e.clientY);
          }
        });

        window.addEventListener("scroll", hidePreview, { passive: true });
        document.addEventListener("swup:willReplaceContent", hidePreview);
      }

      bindEvents();
    })();
  </script>

  <!-- "添加友链" 按钮滚动到评论区 -->
  <script slot="head" is:inline>
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('#btn-add-friend');
      if (!btn) return;
      var comment = document.querySelector('.comment-container, #waline, #tcomment, .giscus');
      if (comment) { comment.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  </script>

  <!-- 友链卡片交互：光晕跟随 / 整卡点击 / 头像懒加载 / 状态注入
       （守卫防 document 级监听重复注册；Swup 导航后新 DOM 的 inline script 会重新执行，
        init 由 astro:page-load / swup:content:replaced 驱动重新绑定） -->
  <script is:inline>
    (function() {
      if (window.__friendCardReady) return;
      window.__friendCardReady = true;

      /* --- 头像懒加载（data-src → src，失败显示涂鸦） --- */
      function loadAvatar(card) {
        var img = card.querySelector(".friend-card-avatar__img");
        if (!img || img.dataset.avatarLoaded) return;
        img.dataset.avatarLoaded = "1";
        var wrap = img.parentElement;
        var src = img.dataset.src;
        if (!wrap || !src) return;
        var TIMEOUT = 5000;
        var timer = setTimeout(function() {
          if (!wrap.classList.contains("is-loaded")) wrap.classList.add("is-error");
        }, TIMEOUT);
        img.addEventListener("load", function() {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        });
        img.addEventListener("error", function() {
          clearTimeout(timer);
          wrap.classList.add("is-error");
        });
        img.src = src;
        if (img.complete && img.naturalWidth > 0) {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        }
      }

      var io = null;
      function bindAvatarObserver() {
        if (io) io.disconnect();
        var cards = document.querySelectorAll(".friend-card");
        if (!cards.length) return;
        io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting) return;
            loadAvatar(entry.target);
            io.unobserve(entry.target);
          });
        }, { rootMargin: "200px 0px" });
        cards.forEach(function(card) { io.observe(card); });
      }

      /* --- 鼠标跟随光晕（事件委托到网格容器，一次绑定） --- */
      function bindGlow() {
        document.querySelectorAll("[data-friends-grid]").forEach(function(grid) {
          if (grid.dataset.glowBound) return;
          grid.dataset.glowBound = "1";
          grid.addEventListener("mousemove", function(e) {
            var card = e.target.closest(".friend-card");
            if (!card) return;
            var rect = card.getBoundingClientRect();
            card.style.setProperty("--mouse-x", (e.clientX - rect.left) + "px");
            card.style.setProperty("--mouse-y", (e.clientY - rect.top) + "px");
          });
        });
      }

      /* --- 整卡点击（事件委托：click / Enter / Space；头像 overlay 链接优先） --- */
      function bindCardClick() {
        document.addEventListener("click", function(e) {
          var card = e.target.closest(".friend-card");
          if (!card || e.target.closest("a")) return;
          var href = card.dataset.href;
          if (href) window.open(href, "_blank", "noopener,noreferrer");
        });
        document.addEventListener("keydown", function(e) {
          if (e.key !== "Enter" && e.key !== " ") return;
          var card = e.target.closest(".friend-card");
          if (!card) return;
          var href = card.dataset.href;
          if (href) { e.preventDefault(); window.open(href, "_blank", "noopener,noreferrer"); }
        });
      }

      /* --- 状态注入：fetch friends-status.json 按 siteurl 匹配（无 JSON 静默隐藏） --- */
      var statusFetched = false;
      function bindStatus() {
        if (statusFetched) return;
        statusFetched = true;
        fetch("/friends-status.json")
          .then(function(r) { if (!r.ok) throw new Error("status json missing"); return r.json(); })
          .then(function(data) {
            var sites = data.sites || {};
            document.querySelectorAll(".friend-card").forEach(function(card) {
              var info = sites[card.dataset.siteurl];
              var tag = card.querySelector(".friend-status-tag");
              if (!tag || !info) return;
              tag.classList.add("friend-status-tag--" + info.status);
              tag.querySelector(".friend-status-text").textContent =
                info.status === "down" ? "DOWN" : (info.ms + " MS");
              tag.hidden = false;
            });
          })
          .catch(function() { /* 无 JSON：静默隐藏徽标 */ });
      }

      function init() {
        bindAvatarObserver();
        bindGlow();
        bindCardClick();
        bindStatus();
      }

      init();
      document.addEventListener("astro:page-load", init);
      document.addEventListener("swup:content:replaced", init);
    })();
  </script>

</MainGridLayout>
