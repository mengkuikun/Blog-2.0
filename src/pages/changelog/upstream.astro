---
import ChangelogGraph from "@components/about/ChangelogGraph.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.changelog) {
	return Astro.redirect("/404/");
}

const displayTitle = "团子原版历史更新图谱";
const displaySubtitle =
	"致敬原作者 团子 (tianshihao2003) · 《团子和蛋糕的博客》83 项早期探索与技术演进";
---

<MainGridLayout title={displayTitle} description={displaySubtitle}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="mb-6">
				<div class="flex flex-wrap items-center justify-between gap-4 mb-3">
					<div class="flex items-center gap-3">
						<Icon name="material-symbols:history-edu" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
						<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">{displayTitle}</div>
					</div>
					<a
						href="/changelog/"
						class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-primary hover:text-white dark:hover:bg-primary dark:hover:text-white transition-all shadow-xs"
					>
						<Icon name="material-symbols:arrow-back-rounded" class="text-sm" />
						<span>返回当前更新日志</span>
					</a>
				</div>

				<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
					{displaySubtitle}
				</p>

				<div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700/60 text-xs text-neutral-600 dark:text-neutral-300 flex flex-wrap items-center justify-between gap-3">
					<div class="flex items-center gap-2">
						<span class="text-base">📜</span>
						<span>本页呈现 2026-09-27 前由团子在「团子和蛋糕的博客」持续迭代的全部 83 份历史更新。感谢团子打下的坚实基石！</span>
					</div>
					<div class="flex items-center gap-3 shrink-0">
						<a
							href="https://blog.tsh520.cn/"
							target="_blank"
							rel="noopener noreferrer"
							class="text-primary hover:underline font-medium inline-flex items-center gap-1"
						>
							<span>团子和蛋糕的博客</span>
							<Icon name="material-symbols:open-in-new-rounded" class="text-xs" />
						</a>
						<a
							href="https://github.com/tianshihao2003/dumplingandcakeblog"
							target="_blank"
							rel="noopener noreferrer"
							class="text-neutral-600 dark:text-neutral-400 hover:text-primary hover:underline font-medium inline-flex items-center gap-1"
						>
							<span>GitHub 源码仓库</span>
							<Icon name="material-symbols:open-in-new-rounded" class="text-xs" />
						</a>
					</div>
				</div>
			</div>

			<ChangelogGraph limit={0} collectionName="upstreamChangelog" />
		</div>
	</div>
</MainGridLayout>
