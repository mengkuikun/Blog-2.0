---
import { render } from "astro:content";
import * as path from "node:path";
import Comment from "@components/comment/index.astro";
import ImageWrapper from "@components/common/ImageWrapper.astro";
import Markdown from "@components/common/Markdown.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import RelatedPosts from "@components/misc/RelatedPosts.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import ArticleTtsPlayer from "@/components/features/ArticleTtsPlayer.svelte";
import PostBreadcrumb from "@/components/layout/PostBreadcrumb.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import { commentConfig, ttsConfig } from "@/config";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { getCategoryFromId } from "@/utils/category-tree";
import { formatDateI18n, formatDateToYYYYMMDD } from "@/utils/date-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import { getCategoryUrl, getTagUrl, url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

// 处理随机图：如果image为"api"，则从配置的API获取随机图（用于分享海报）
const processedImage = processCoverImageSync(entry.data.image, entry.id);

let posterCoverUrl = processedImage;
if (processedImage) {
	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);
	if (isLocal) {
		const basePath = getFileDirFromPath(entry.filePath || "");
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		let normalizedPath = path
			.normalize(path.join("../../", basePath, processedImage))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterCoverUrl = img.src;
		}
	}
}

// 处理头像URL
let posterAvatarUrl: string | null = profileConfig.avatar || null;
if (posterAvatarUrl) {
	const isLocalAvatar = !(
		posterAvatarUrl.startsWith("/") ||
		posterAvatarUrl.startsWith("http") ||
		posterAvatarUrl.startsWith("https") ||
		posterAvatarUrl.startsWith("data:")
	);
	if (isLocalAvatar) {
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../", posterAvatarUrl))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterAvatarUrl = img.src;
		}
	}
}

dayjs.extend(utc);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  headings={headings}
  prevSlug={entry.data.prevSlug}
  prevTitle={entry.data.prevTitle}
  nextSlug={entry.data.nextSlug}
  nextTitle={entry.data.nextTitle}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <!-- 面包屑导航 -->
  <PostBreadcrumb title={entry.data.title} category={getCategoryFromId(entry.id) || undefined} />

  <!-- Layer 1: Hero — 居中标题 + 紧凑 Meta 行 -->
  <div class="post-hero rounded-(--radius-large) mb-2 onload-animation">
    <div class="post-hero__content">
      <h1
        data-pagefind-body
        data-pagefind-weight="10"
        data-pagefind-meta="title"
        class="post-hero__title"
      >
        {entry.data.title}
      </h1>

      <div class="post-hero__meta-row">
        <span class="post-hero__meta-item">
          {formatDateI18n(entry.data.published)}
        </span>

        <span class="post-hero__meta-dot">·</span>

        <a href={getCategoryUrl(getCategoryFromId(entry.id) || null)} class="post-hero__meta-link">
          #{getCategoryFromId(entry.id) || i18n(I18nKey.uncategorized)}
        </a>

        {entry.data.tags && entry.data.tags.length > 0 && entry.data.tags.map((tag, i) => (
          <span class="post-hero__meta-tag">
            {i > 0 && <span class="post-hero__meta-sep">/</span>}
            <a href={getTagUrl(tag)} class="post-hero__meta-link">{tag.trim()}</a>
          </span>
        ))}

        <span class="post-hero__meta-dot">·</span>

        <span class="post-hero__meta-item">
          {remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)} {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
        </span>

      </div>

      {/* 移动端：浏览量 + 分享独立一行 */}
      <div class="post-hero__meta-extra">
        {
          commentConfig.type === 'twikoo' && commentConfig.twikoo?.visitorCount && (
            <span class="post-hero__views">
              <span class="mr-1">{i18n(I18nKey.pageViews)}</span>
              <span id="twikoo_visitors">{i18n(I18nKey.pageViewsLoading)}</span>
            </span>
          )
        }

        {
          commentConfig.type === 'waline' && commentConfig.waline?.visitorCount && (
            <span class="post-hero__views">
              <span class="mr-1">{i18n(I18nKey.pageViews)}</span>
              <span class="waline-pageview-count" data-path={`/posts/${removeFileExtension(entry.id)}`}>{i18n(I18nKey.pageViewsLoading)}</span>
            </span>
          )
        }

        {
          commentConfig.type === 'artalk' && commentConfig.artalk?.visitorCount && (
            <span class="post-hero__views">
              <span class="mr-1">{i18n(I18nKey.pageViews)}</span>
              <span class="artalk-pv-count" data-path={`/posts/${removeFileExtension(entry.id)}`}>{i18n(I18nKey.pageViewsLoading)}</span>
            </span>
          )
        }

        {siteConfig.sharePoster && (
          <span class="post-hero__share"><SharePoster
            client:load
            title={entry.data.title}
            author={profileConfig.name}
            description={entry.data.description || entry.data.title}
            pubDate={formatDateToYYYYMMDD(entry.data.published)}
            coverImage={posterCoverUrl}
            url={Astro.url.href}
            siteTitle={siteConfig.title}
            avatar={posterAvatarUrl}
          /></span>
        )}

        {ttsConfig.enable && (
          <span class="post-hero__tts"><ArticleTtsPlayer
            client:load
            title={entry.data.title}
            cover={posterCoverUrl}
          /></span>
        )}
    </div>
  </div>
</div>

  <!-- Layer 2: 三合一引言卡（时效提醒 + AI 摘要 + 封面图） -->
  {
    (entry.data.description || processedImage || siteConfig.showLastModified) && (
      <div class="mb-4">
        <div class="post-intro-card">
          {/* 1. 时效提醒 */}
          {siteConfig.showLastModified && (
            <>
              <div
                id="outdated-info"
                class="post-intro-card__outdated hidden"
                data-date={(entry.data.updated || entry.data.published).toISOString()}
                data-threshold={siteConfig.outdatedThreshold ?? 30}
              >
                <div class="post-intro-card__section">
                  <div class="post-intro-card__row">
                    <Icon name="material-symbols:info-outline-rounded" class="post-intro-card__icon" />
                    <span class="post-intro-card__text">
                      {i18n(I18nKey.lastModifiedPrefix)}{formatDateToYYYYMMDD(entry.data.updated || entry.data.published)}
                      <span id="days-ago-text-intro" class="outdated-days" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
                      <span id="outdated-warning-intro" class="outdated-warning hidden">，{i18n(I18nKey.lastModifiedOutdated)}</span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="post-intro-card__divider"></div>
            </>
          )}

          {/* 2. AI 摘要 */}
          {entry.data.description && (
            <details class="post-intro-card__details" open>
              <summary class="post-intro-card__summary">
                <span class="post-intro-card__summary-title">
                  <Icon name="material-symbols:auto-awesome" class="post-intro-card__summary-icon" />
                  <span>{(entry.data as any).descriptionSource !== "manual" ? "AI 摘要" : "简介"}</span>
                  {(entry.data as any).descriptionSource !== "manual" && (
                    <span class="post-intro-card__summary-model">- DeepSeek</span>
                  )}
                </span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-intro-card__summary-arrow" />
              </summary>
              <div class="post-intro-card__section post-intro-card__section--summary">
                <p class="post-intro-card__desc">{entry.data.description}</p>
              </div>
            </details>
          )}

          {/* 分割线（仅在同时有摘要和封面图时渲染） */}
          {entry.data.description && processedImage && (
            <div class="post-intro-card__divider"></div>
          )}

          {/* 3. 封面图折叠 */}
          {processedImage && (
            <details class="post-intro-card__details" open>
              <summary class="post-intro-card__summary">
                <span class="post-intro-card__summary-title">
                  <Icon name="material-symbols:image-outline-rounded" class="post-intro-card__summary-icon" />
                  <span>封面图</span>
                </span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-intro-card__summary-arrow" />
              </summary>
              <div class="post-intro-card__section post-intro-card__section--cover">
                <div id="post-cover" class="post-intro-card__cover">
                  <ImageWrapper
                    src={processedImage}
                    alt={entry.data.title}
                    basePath={getFileDirFromPath(entry.filePath || "")}
                    class="w-full h-auto object-cover rounded-xl"
                  />
                </div>
              </div>
            </details>
          )}
        </div>
      </div>
    )
  }

  <!-- 文章正文卡片 -->
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-3 md:px-6 lg:px-10 pb-4 pt-0 relative w-full ",
        {},
      ]}
    >

      <Markdown class="mb-6 markdown-content onload-animation">
        <Content />
      </Markdown>
    </div>
  </div>



  <div
    class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
  >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
      class:list={[
        "w-full font-bold overflow-hidden active:scale-95",
        { "pointer-events-none": !entry.data.nextSlug },
      ]}
    >
      {
        entry.data.nextSlug && (
          <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
            <Icon
              name="material-symbols:chevron-left-rounded"
              class="text-[2rem] text-(--primary)"
            />
            <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
              {entry.data.nextTitle}
            </div>
          </div>
        )
      }
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
      class:list={[
        "w-full font-bold overflow-hidden active:scale-95",
        { "pointer-events-none": !entry.data.prevSlug },
      ]}
    >
      {
        entry.data.prevSlug && (
          <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
            <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
              {entry.data.prevTitle}
            </div>
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="text-[2rem] text-(--primary)"
            />
          </div>
        )
      }
    </a>
  </div>

  <!-- 相关阅读 -->
  <RelatedPosts
    currentSlug={entry.id}
    currentTags={entry.data.tags || []}
    currentCategory={getCategoryFromId(entry.id) || undefined}
    maxCount={5}
  />

  <!-- 评论 -->
  {entry.data.comment && <Comment post={entry} />}

  <!-- 时效性客户端动态计算脚本 -->
  <script is:inline>
    function updateOutdatedNotice() {
      const el = document.getElementById("outdated-info");
      if (!el || !el.dataset.date) return;
      const targetDate = new Date(el.dataset.date);
      const diffDays = Math.floor((Date.now() - targetDate.getTime()) / (1000 * 60 * 60 * 24));
      const threshold = Number(el.dataset.threshold || 30);
      if (diffDays >= threshold) {
        el.classList.remove("hidden");
        if (diffDays >= 1) {
          const daysText = document.getElementById("days-ago-text-intro");
          if (daysText && daysText.dataset.template) {
            daysText.textContent = `，${daysText.dataset.template.replace("{days}", diffDays.toString())}`;
          }
          const warningEl = document.getElementById("outdated-warning-intro");
          if (warningEl) warningEl.classList.remove("hidden");
        }
      }
    }

    updateOutdatedNotice();

    if (!window.__postOutdatedNoticeInited) {
      window.__postOutdatedNoticeInited = true;
      document.addEventListener("swup:content:replaced", updateOutdatedNotice);
    }
  </script>
</MainGridLayout>
