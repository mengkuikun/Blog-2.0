---
import { getCollection } from "astro:content";
import AppCard from "@components/features/AppCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";

// 从 content/apps 目录读取应用数据，按权重排序
const appsEntries = await getCollection("apps");
const items = appsEntries
	.filter((item) => item.data.enabled !== false)
	.sort((a, b) => (b.data.weight || 0) - (a.data.weight || 0));

const allTags = [
	...new Set(items.flatMap((item) => item.data.tags || [])),
].sort();

const title = "应用展示";
const description = "我使用过的应用和工具推荐";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面大标题（带签写动画与手写字体） -->
      <div class="mb-6">
        <PageTitle
          icon="material-symbols:apps"
          title={title}
          description={description}
        />
      </div>

      <!-- 标签筛选 -->
      {
        items.length > 0 && (
          <div class="app-filter-tabs flex flex-wrap gap-1 mb-6 p-1 rounded-full border border-neutral-900 dark:border-neutral-100" data-app-filter>
            <button
              data-tag="all"
              class="app-tab-btn relative z-10 px-4 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 text-white dark:text-neutral-900"
            >
              全部
            </button>
            {allTags.map((tag) => (
              <button
                data-tag={tag}
                class="app-tab-btn relative z-10 px-4 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 text-neutral-900 dark:text-neutral-100"
              >
                {tag}
              </button>
            ))}
            <div class="app-tab-indicator absolute top-1 bottom-1 bg-neutral-900 dark:bg-neutral-100 rounded-full transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] pointer-events-none" style="left: 4px; width: 0px;"></div>
          </div>
        )
      }

      <div class="apps-grid" data-apps-grid data-page-size="9">
        {
          items.map((item) => (
            <div class="app-card" data-tags={item.data.tags?.join(",")} data-title={item.data.title}>
              <AppCard
                title={item.data.title}
                imgurl={item.data.imgurl}
                desc={item.data.desc}
                tags={item.data.tags}
              />
            </div>
          ))
        }
      </div>

      <!-- 分页 -->
      <nav class="apps-pagination" data-apps-pagination hidden aria-label="应用分页">
        <button type="button" class="apps-page-btn" data-page-prev aria-label="上一页">
          <Icon name="material-symbols:chevron-left-rounded" class="text-lg" />
        </button>
        <div class="apps-page-nums" data-page-nums></div>
        <button type="button" class="apps-page-btn" data-page-next aria-label="下一页">
          <Icon name="material-symbols:chevron-right-rounded" class="text-lg" />
        </button>
      </nav>
    </div>
  </div>

  <!-- 标签筛选 + 分页 + 头像懒加载 -->
  <script is:inline>
    (function() {
      if (window.__appFilterReady) return;
      window.__appFilterReady = true;

      var state = new WeakMap();

      function getState(root) {
        var s = state.get(root);
        if (!s) {
          s = { tag: "all", page: 1 };
          state.set(root, s);
        }
        return s;
      }

      function updateIndicator(container, button) {
        var indicator = container.querySelector(".app-tab-indicator");
        if (!indicator || !button) return;
        var parentRect = container.getBoundingClientRect();
        var btnRect = button.getBoundingClientRect();
        indicator.style.left = (btnRect.left - parentRect.left) + "px";
        indicator.style.width = btnRect.width + "px";
        indicator.style.opacity = "1";
      }

      function render(root) {
        var grid = root.querySelector("[data-apps-grid]");
        if (!grid) return;
        var s = getState(root);
        var pageSize = parseInt(grid.dataset.pageSize, 10) || 9;

        var cards = Array.prototype.slice.call(grid.querySelectorAll(".app-card"));
        var matched = cards.filter(function(card) {
          if (s.tag === "all") return true;
          var tags = (card.dataset.tags || "").split(",");
          return tags.indexOf(s.tag) !== -1;
        });

        var totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
        if (s.page > totalPages) s.page = totalPages;
        if (s.page < 1) s.page = 1;

        var start = (s.page - 1) * pageSize;
        var end = start + pageSize;
        var matchedSet = new Set(matched);

        cards.forEach(function(card) {
          var idx = matched.indexOf(card);
          var visible = matchedSet.has(card) && idx >= start && idx < end;
          if (visible) {
            card.style.display = "block";
            card.classList.add("animate-fade-in-up");
            loadAvatar(card);
          } else {
            card.style.display = "none";
            card.classList.remove("animate-fade-in-up");
          }
        });

        renderPagination(root, s.page, totalPages);
      }

      function renderPagination(root, page, totalPages) {
        var nav = root.querySelector("[data-apps-pagination]");
        if (!nav) return;
        if (totalPages <= 1) {
          nav.hidden = true;
          return;
        }
        nav.hidden = false;

        var prev = nav.querySelector("[data-page-prev]");
        var next = nav.querySelector("[data-page-next]");
        if (prev) prev.disabled = page <= 1;
        if (next) next.disabled = page >= totalPages;

        var nums = nav.querySelector("[data-page-nums]");
        if (!nums) return;
        nums.innerHTML = "";
        for (var i = 1; i <= totalPages; i++) {
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "apps-page-num" + (i === page ? " is-active" : "");
          btn.dataset.pageGo = String(i);
          btn.textContent = String(i);
          nums.appendChild(btn);
        }
      }

      document.addEventListener("click", function(e) {
        var button = e.target.closest(".app-tab-btn");
        if (!button) return;
        var container = button.closest("[data-app-filter]");
        if (!container) return;
        var root = container.closest(".card-base");
        if (!root) return;

        var s = getState(root);
        s.tag = button.dataset.tag;
        s.page = 1;

        updateIndicator(container, button);

        var filters = container.querySelectorAll(".app-tab-btn");
        filters.forEach(function(f) {
          if (f === button) {
            f.classList.remove("text-neutral-900", "dark:text-neutral-100");
            f.classList.add("text-white", "dark:text-neutral-900");
          } else {
            f.classList.remove("text-white", "dark:text-neutral-900");
            f.classList.add("text-neutral-900", "dark:text-neutral-100");
          }
        });

        render(root);
      });

      document.addEventListener("click", function(e) {
        var nav = e.target.closest("[data-apps-pagination]");
        if (!nav) return;
        var root = nav.closest(".card-base");
        if (!root) return;
        var s = getState(root);

        var go = e.target.closest("[data-page-go]");
        if (go) {
          s.page = parseInt(go.dataset.pageGo, 10) || 1;
        } else if (e.target.closest("[data-page-prev]")) {
          s.page = Math.max(1, s.page - 1);
        } else if (e.target.closest("[data-page-next]")) {
          s.page = s.page + 1;
        } else {
          return;
        }

        render(root);
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      function loadAvatar(card) {
        var img = card.querySelector(".app-card-avatar__img");
        if (!img || img.dataset.avatarLoaded) return;
        img.dataset.avatarLoaded = "1";

        var wrap = img.parentElement;
        var src = img.dataset.src;
        if (!wrap || !src) return;

        var TIMEOUT = 5000;
        var timer = setTimeout(function() {
          if (!wrap.classList.contains("is-loaded")) {
            wrap.classList.add("is-error");
          }
        }, TIMEOUT);

        img.addEventListener("load", function() {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        });
        img.addEventListener("error", function() {
          clearTimeout(timer);
          wrap.classList.add("is-error");
        });

        img.src = src;
        if (img.complete && img.naturalWidth > 0) {
          clearTimeout(timer);
          wrap.classList.remove("is-error");
          wrap.classList.add("is-loaded");
        }
      }

      function init() {
        document.querySelectorAll(".card-base").forEach(function(root) {
          var container = root.querySelector("[data-app-filter]");
          if (container) {
            var s = getState(root);
            var activeBtn = container.querySelector('[data-tag="' + s.tag + '"]')
              || container.querySelector('[data-tag="all"]');
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                if (activeBtn) updateIndicator(container, activeBtn);
              });
            });
          }
          if (root.querySelector("[data-apps-grid]")) {
            render(root);
          }
        });
      }

      init();
      document.addEventListener("astro:page-load", init);

      window.addEventListener("resize", function() {
        document.querySelectorAll(".card-base").forEach(function(root) {
          var container = root.querySelector("[data-app-filter]");
          if (!container) return;
          var activeBtn = container.querySelector(".app-tab-btn.text-white, .app-tab-btn.text-neutral-900");
          if (!activeBtn) activeBtn = container.querySelector('[data-tag="all"]');
          if (activeBtn) updateIndicator(container, activeBtn);
        });
      });
    })();
  </script>
</MainGridLayout>
